# Dockerfile for CUDA-Accelerated George Sandbox
ARG BASE_IMAGE=nvidia/cuda:12.4.1-devel-ubuntu22.04
FROM ${BASE_IMAGE}

# Prevent interactive prompts during package install
ENV DEBIAN_FRONTEND=noninteractive

# Backend type: cuda, vulkan, or cpu
ARG BACKEND=cuda

# Install runtime and compilation dependencies
RUN apt-get update && apt-get install -y \
    curl \
    jq \
    git \
    sqlite3 \
    cmake \
    ninja-build \
    gcc \
    g++ \
    libcurl4-openssl-dev \
    libssl-dev \
    procps \
    && if [ "$BACKEND" = "vulkan" ]; then \
        sed -i 's/main/main universe/g' /etc/apt/sources.list && \
        apt-get update && \
        apt-get install -y ca-certificates gnupg2 && \
        curl -fsSL https://packages.lunarg.com/lunarg-signing-key-pub.asc | tee /etc/apt/trusted.gpg.d/lunarg.asc && \
        curl -fsSL -o /etc/apt/sources.list.d/lunarg-vulkan-jammy.list https://packages.lunarg.com/vulkan/lunarg-vulkan-jammy.list && \
        apt-get update && \
        apt-get install -y libvulkan-dev vulkan-tools spirv-headers vulkan-sdk; \
    fi \
    && rm -rf /var/lib/apt/lists/*

# Clone and compile llama.cpp from source
RUN git clone https://github.com/ggml-org/llama.cpp.git /opt/llama.cpp && \
    cd /opt/llama.cpp && \
    if [ "$BACKEND" = "cuda" ]; then \
        ln -s libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1 || true && \
        export LIBRARY_PATH=/usr/local/cuda/lib64/stubs && \
        cmake -B build -DGGML_CUDA=ON -DLLAMA_CURL=ON -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_EXE_LINKER_FLAGS="-Wl,-rpath-link,/usr/local/cuda/lib64/stubs" \
            -DCMAKE_SHARED_LINKER_FLAGS="-Wl,-rpath-link,/usr/local/cuda/lib64/stubs" \
            -G Ninja; \
    elif [ "$BACKEND" = "vulkan" ]; then \
        cmake -B build -DGGML_VULKAN=ON -DLLAMA_CURL=ON -DCMAKE_BUILD_TYPE=Release -G Ninja; \
    elif [ "$BACKEND" = "rocm" ]; then \
        cmake -B build -DGGML_HIPBLAS=ON -DLLAMA_CURL=ON -DCMAKE_BUILD_TYPE=Release -G Ninja; \
    else \
        cmake -B build -DLLAMA_CURL=ON -DCMAKE_BUILD_TYPE=Release -G Ninja; \
    fi && \
    cmake --build build --config Release --target llama-server -j$(nproc)

# Expose default llama-server port
EXPOSE 8080

# Set environment variables for compilation path
ENV LLAMA_CPP_SERVER_BIN=/opt/llama.cpp/build/bin/llama-server
ENV LLM_BACKEND=llamacpp

# Create a non-root user for safe workspace execution
ARG USER_ID=1000
ARG GROUP_ID=1000
RUN groupadd -g ${GROUP_ID} george && \
    useradd -u ${USER_ID} -g george -m george

USER george
WORKDIR /workspace

CMD ["/bin/bash"]
