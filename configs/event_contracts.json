{
  "version": 1,
  "description": "Blue Lodge event contract registry (refinement P1/1.1). Every event type emitted anywhere must have a row here. handling: reactor = at least one reactor consumes it; store = persisted to events.db for queries/dashboards only; test_only = allowed only under the test sandbox; deprecated = must not be emitted (alias noted). required = payload fields that must be present and non-null.",
  "contracts": [
    {"type": "system.job_failure", "domain": "system", "handling": "reactor", "reactors": ["rx_remediation_job"], "retention_days": 90,
     "required": ["job", "job_id", "label", "exit_code", "stderr_tail", "wall_s"],
     "description": "Scheduled cron job or asynchronous IPC task exited non-zero. Carries redacted stderr tail and wall time for remediation intake."},
    {"type": "system.cron_failure", "domain": "system", "handling": "deprecated", "alias_of": "system.job_failure", "retention_days": 30,
     "description": "Legacy alias; never emitted. Use system.job_failure."},
    {"type": "system.phytology_fault", "domain": "system", "handling": "reactor", "reactors": ["rx_remediation_phytology"], "retention_days": 90,
     "description": "Phytology living-tissue health check degraded."},
    {"type": "system.sentinel_fault", "domain": "system", "handling": "reactor", "reactors": ["rx_remediation_sentinel"], "retention_days": 90,
     "description": "Sentinel telemetry anomaly escalated for remediation."},
    {"type": "ci.build_failure", "domain": "system", "handling": "reactor", "reactors": ["rx_remediation_ci"], "retention_days": 90,
     "description": "Gitea Actions CI run failed."},
    {"type": "system_telemetry", "domain": "system", "handling": "store", "retention_days": 30,
     "description": "Core daemon heartbeat, memory, and task bay operational telemetry."},

    {"type": "remediation.worker_heartbeat", "domain": "remediation", "handling": "store", "retention_days": 7,
     "required": ["ts", "queue_depth", "in_progress", "mode"],
     "description": "Remediation worker liveness (queue depth, in-progress count, apply mode)."},
    {"type": "remediation.orphan_reclaimed", "domain": "remediation", "handling": "store", "retention_days": 90,
     "description": "An orphaned in_progress remediation item was requeued or failed."},
    {"type": "remediation.intake", "domain": "remediation", "handling": "store", "retention_days": 90,
     "description": "New fault or failure item enqueued into the remediation intake queue."},

    {"type": "agent.tool_failure", "domain": "agent", "handling": "store", "retention_days": 90,
     "required": ["session_id", "tool", "error_class"],
     "description": "A ReAct tool call failed (bridged from telemetry anomalies)."},
    {"type": "agent.circuit_breaker", "domain": "agent", "handling": "store", "retention_days": 90,
     "required": ["session_id", "breaker_class"],
     "description": "A ReAct circuit breaker tripped (thrashing, empty turns, etc.)."},
    {"type": "agent.run_complete", "domain": "agent", "handling": "store", "retention_days": 90,
     "required": ["session_id", "outcome", "turns", "wall_s"],
     "description": "A ReAct run finished; outcome from the run-ledger taxonomy."},
    {"type": "search.engine_degraded", "domain": "search", "handling": "store", "retention_days": 30,
     "required": ["engines"],
     "description": "SearXNG reported unresponsive/suspended engines for a query."},

    {"type": "WAKE_TASK", "domain": "ipc", "handling": "reactor", "reactors": ["rx_wake_task"], "retention_days": 7,
     "description": "Resume a parked agent state machine task (payload.uuid)."},
    {"type": "FAULT_QUARANTINE", "domain": "ipc", "handling": "reactor", "reactors": ["rx_fault_quarantine"], "retention_days": 30,
     "description": "Agent state machine quarantined a faulting task."},

    {"type": "crypto_price_tick", "domain": "crypto", "handling": "reactor", "reactors": ["rx_coinbase_btc", "rx_coinbase_ada"], "retention_days": 60,
     "description": "Live cryptocurrency spot price snapshot from exchange ticker."},
    {"type": "wallet_balance_tick", "domain": "crypto", "handling": "store", "retention_days": 60,
     "description": "Periodic wallet balance poll (cron_wallet_poll)."},
    {"type": "sovereign_trading_tick", "domain": "crypto", "handling": "reactor", "reactors": ["rx_sovereign_trading"], "retention_days": 30,
     "description": "Sovereign trading loop tick."},
    {"type": "cardano/maker_filled", "domain": "cardano", "handling": "reactor", "reactors": ["rx_maker_sell"], "retention_days": 90,
     "description": "A maker buy order filled; triggers the paired sell."},
    {"type": "cardano/maker_sell_placed", "domain": "cardano", "handling": "store", "retention_days": 90,
     "description": "Paired maker sell order placed."},
    {"type": "cardano/order_stale", "domain": "cardano", "handling": "reactor", "reactors": ["rx_stale_order_canceller"], "retention_days": 90,
     "description": "Open order exceeded its staleness window."},
    {"type": "cardano/order_expired", "domain": "cardano", "handling": "reactor", "reactors": ["rx_order_expired_log"], "retention_days": 90,
     "description": "Order expired on-chain."},
    {"type": "cardano/order_placed", "domain": "cardano", "handling": "reactor", "reactors": ["rx_order_placed_log"], "retention_days": 90,
     "description": "Order placed."},
    {"type": "cardano/order_reclaim_submitted", "domain": "cardano", "handling": "reactor", "reactors": ["rx_order_reclaim_log"], "retention_days": 90,
     "description": "Reclaim transaction submitted for an order."},
    {"type": "cardano/order_cancelled", "domain": "cardano", "handling": "store", "retention_days": 90,
     "description": "Order cancelled."},
    {"type": "cardano/order_filled", "domain": "cardano", "handling": "store", "retention_days": 90,
     "description": "Order filled on-chain."},
    {"type": "cardano/price_tick", "domain": "cardano", "handling": "reactor", "reactors": ["rx_cardano_stop_reactor"], "retention_days": 30,
     "description": "Live Cardano DEX spot price tick for armed stop/trailing triggers."},
    {"type": "cardano/stop_executed", "domain": "cardano", "handling": "store", "retention_days": 90,
     "description": "Armed breakout stop-buy order triggered and executed."},
    {"type": "cardano/stop_disarmed", "domain": "cardano", "handling": "store", "retention_days": 90,
     "description": "Armed breakout stop-buy order disarmed on price invalidation."},
    {"type": "cardano/stop_loss_executed", "domain": "cardano", "handling": "store", "retention_days": 90,
     "description": "Protective stop-loss order triggered and executed."},
    {"type": "cardano/bracket_completed", "domain": "cardano", "handling": "store", "retention_days": 90,
     "description": "Bracket order cycle completed."},
    {"type": "cardano/ada_reserve_harvested", "domain": "cardano", "handling": "store", "retention_days": 90,
     "description": "Realized ADA profit harvested to sovereign reserve."},
    {"type": "cardano/dry_run_simulated", "domain": "cardano", "handling": "store", "retention_days": 60,
     "description": "Simulated 2-leg Cardano DEX arbitrage dry-run record."},
    {"type": "cardano/trade_completed", "domain": "cardano", "handling": "store", "retention_days": 90,
     "description": "Completed live 2-leg Cardano DEX arbitrage round-trip."},
    {"type": "cardano/maker_simulated", "domain": "cardano", "handling": "store", "retention_days": 60,
     "description": "Simulated Cardano market-maker resting limit order."},
    {"type": "cardano/maker_placed", "domain": "cardano", "handling": "store", "retention_days": 90,
     "description": "Live Cardano market-maker resting limit order placed on-chain."},

    {"type": "polymarket_market_shift", "domain": "prediction_markets", "handling": "reactor", "reactors": ["rx_polymarket_active"], "retention_days": 90,
     "description": "Active prediction market odds tick and implied volume."},
    {"type": "polymarket_sentiment_signal", "domain": "prediction_markets", "handling": "reactor", "reactors": ["rx_trading_poly"], "retention_days": 90,
     "description": "Sentiment signal for a prediction market (trading_bot / finance_osint config)."},
    {"type": "finance_crypto_signal", "domain": "finance_osint", "handling": "reactor", "reactors": ["rx_trading_crypto"], "retention_days": 90,
     "description": "Grant, bounty, or ecosystem catalyst targeting developer infrastructure."},
    {"type": "finance_opportunity_alert", "domain": "finance_osint", "handling": "reactor", "reactors": ["rx_trading_alert"], "retention_days": 90,
     "description": "Synthesized high-priority revenue or funding opportunity."},
    {"type": "finance_synthesis_complete", "domain": "finance_osint", "handling": "store", "retention_days": 90,
     "description": "Synthesis worker finished a batch."},

    {"type": "compute_listing_seen", "domain": "compute_market", "handling": "store", "retention_days": 90,
     "description": "Raw compute hardware listing discovered on secondary marketplace."},
    {"type": "compute_deal_alert", "domain": "compute_market", "handling": "reactor", "reactors": ["rx_compute_deal"], "retention_days": 90,
     "description": "Evaluated GPU or RAM deal exceeding alpha discount threshold."},
    {"type": "compute_deal_verified", "domain": "compute_market", "handling": "store", "retention_days": 90,
     "description": "Authentic GPU or RAM deal verified by agentic website fetch."},
    {"type": "compute_deal_rejected", "domain": "compute_market", "handling": "store", "retention_days": 90,
     "description": "Fake, parts-only, or scam deal rejected by forensic verifier."},

    {"type": "osint_listing", "domain": "osint", "handling": "store", "retention_days": 60,
     "description": "Generic marketplace listing matched by an OSINT watcher."},
    {"type": "osint_shopify_drop", "domain": "osint", "handling": "store", "retention_days": 60,
     "description": "Shopify product drop matched by an OSINT watcher."},
    {"type": "osint_threat_alert", "domain": "osint", "handling": "store", "retention_days": 90,
     "description": "Credential-exposure sentinel hit. Stored only: ~200/14d is too noisy for direct alerts; operator decision pending on a deduplicating reactor."},
    {"type": "searxng_rss", "domain": "rss_intel", "handling": "reactor", "reactors": ["rss_news_reactor"], "retention_days": 60,
     "description": "Breaking intelligence headline and URL from SearXNG RSS feed."},

    {"type": "radio_call_ingest", "domain": "sdr_osint", "handling": "store", "retention_days": 90,
     "description": "TrunkRecorder radio call transcript and frequency telemetry."},
    {"type": "sdr_p25_call", "domain": "sdr_osint", "handling": "store", "retention_days": 90,
     "description": "P25 trunked radio call ingested."},
    {"type": "sdr_ipc_call_staged", "domain": "sdr_osint", "handling": "store", "retention_days": 30,
     "description": "SDR radio call staged in IPC pipeline awaiting transcription."},
    {"type": "sdr_call_ingested", "domain": "sdr_osint", "handling": "store", "retention_days": 90,
     "description": "SDR radio call transcribed and persisted to sdr_calls.db."},
    {"type": "sdr_emergency", "domain": "sdr_osint", "handling": "store", "retention_days": 90,
     "description": "Emergency-flagged radio call. Stored only; operator decision pending on alerting."},
    {"type": "sdr_transcription_complete", "domain": "sdr_osint", "handling": "store", "retention_days": 30,
     "description": "SDR audio transcription finished."},

    {"type": "cardano/maker_cycle_completed", "domain": "cardano", "handling": "store", "retention_days": 90,
     "description": "A maker buy/sell cycle completed."},

    {"type": "finance_grant_signal", "domain": "finance_osint", "handling": "store", "retention_days": 90,
     "description": "Grant opportunity matched by finance OSINT watcher (config-driven)."},
    {"type": "finance_vc_signal", "domain": "finance_osint", "handling": "store", "retention_days": 90,
     "description": "VC/funding signal matched by finance OSINT watcher (config-driven)."},
    {"type": "finance_sponsor_signal", "domain": "finance_osint", "handling": "store", "retention_days": 90,
     "description": "Sponsorship signal matched by finance OSINT watcher (config-driven)."},
    {"type": "finance_bounty_signal", "domain": "finance_osint", "handling": "store", "retention_days": 90,
     "description": "Bounty signal matched by finance OSINT watcher (config-driven)."},
    {"type": "finance_contract_signal", "domain": "finance_osint", "handling": "store", "retention_days": 90,
     "description": "Contract-work signal matched by finance OSINT watcher (config-driven)."},
    {"type": "finance_flip_signal", "domain": "finance_osint", "handling": "store", "retention_days": 90,
     "description": "Resale/flip signal matched by finance OSINT watcher (config-driven)."},

    {"type": "tool:created", "domain": "copilot", "handling": "store", "retention_days": 30,
     "description": "Copilot engine created a tool."},
    {"type": "tool:executed", "domain": "copilot", "handling": "store", "retention_days": 30,
     "description": "Copilot engine executed a tool."},
    {"type": "tool:forged", "domain": "copilot", "handling": "store", "retention_days": 30,
     "description": "Copilot engine forged a new tool."},
    {"type": "agent:created", "domain": "copilot", "handling": "store", "retention_days": 30,
     "description": "Copilot engine created an agent."},
    {"type": "workflow:created", "domain": "copilot", "handling": "store", "retention_days": 30,
     "description": "Copilot engine created a workflow."},

    {"type": "webhook_event", "domain": "test", "handling": "test_only", "retention_days": 1,
     "description": "Event bus unit-test fixture."},
    {"type": "test_event", "domain": "test", "handling": "test_only", "retention_days": 1,
     "description": "CLI /react test fixture."},
    {"type": "cascade_event", "domain": "test", "handling": "test_only", "retention_days": 1,
     "description": "Causal-depth cascade test fixture."},
    {"type": "ping", "domain": "test", "handling": "test_only", "retention_days": 1,
     "description": "Liveness test fixture."}
  ]
}
