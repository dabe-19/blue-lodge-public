# ── George: Sovereign Secrets & Environment Configuration (Template) ─────────
# Usage:
#   1. Copy this file to .george/secrets.env (or run ./scripts/infra/init_secrets.sh)
#   2. Populate the API tokens, wallet addresses, and local endpoint configurations
#   3. Secure file permissions: chmod 600 .george/secrets.env
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Homelab & Sovereign Services ──────────────────────────────────────────
SEARXNG_URL=http://127.0.0.1:8081
LOCAL_LLM_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_API_KEY=not-needed

# ── 2. SDR Radio Lab & TrunkRecorder Gateway ─────────────────────────────────
SDR_GATEWAY_USER=operator
SDR_GATEWAY_HOST=127.0.0.1
SDR_SERVER_HOST=127.0.0.1
SDR_TRANSCRIBER_SSH=operator@127.0.0.1
SDR_REMOTE_DIR=/var/log/trunk-recorder
SDR_SSH_KEY=~/.ssh/id_ed25519
SDR_TRANSCRIPTION_ENDPOINT=http://127.0.0.1:8090/v1/audio/transcriptions
SDR_TRANSCRIPTION_ENGINE=faster-whisper-rocm
SDR_TRANSCRIPTION_MODEL=whisper-small.en-p25-lora

# ── 3. Comms, Discord & Operator Identity ────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_DM_USER_ID=
OPERATOR_DISCORD_USER_ID=
OPERATOR_DISCORD_ALT_ID=
OPERATOR_HANDLE=operator
DISCORD_WEBHOOK_URL=

# Weather & Location Defaults (used by morning briefing cron jobs)
GEORGE_WEATHER_CITY="New York"
GEORGE_WEATHER_LAT="40.71"
GEORGE_WEATHER_LON="-74.01"

# ── 4. Polymarket Prediction Markets & EVM (Polygon PoS / Ethereum) ──────────
# Encrypted at rest in .george/wallets/keystore/agent-evm.json
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_CHAIN_ID=137

# ── 5. Bitcoin Blockchain Integration (Signet / Testnet4 / Mainnet) ──────────
BTC_NETWORK=signet
BTC_RPC_URL=http://127.0.0.1:38332
BTC_RPC_USER=george
BTC_RPC_PASS=
BTC_FUNDING_ADDRESS=

# ── 6. Cardano Blockchain Integration (Preprod / Mainnet) ─────────────────────
# Signing keys are encrypted at rest in .george/wallets/keystore/agent-hot.json
# and auto-unlocked via .george/secrets/agent_keystore.key (0600).
CARDANO_NETWORK=mainnet
BLOCKFROST_PROJECT_ID=
CARDANO_ENTERPRISE_ADDR=
CARDANO_WALLET_ADDR=
CARDANO_HOT_STAKE_ADDR=
CARDANO_COLD_STAKE_ADDR=

# ── 7. Commercial Cloud LLMs (Optional Fallback) ─────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
