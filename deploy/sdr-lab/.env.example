# ==============================================================================
# Blue Lodge Sovereign SDR Lab — Environment Configuration (.env.example)
# ==============================================================================

# --- 1. Deployment & Capture Mode ---
# Options for SDR_CAPTURE_MODE:
#   - "remote_ssh" : Pulls recordings from a remote edge SDR host (`SDR_REMOTE_HOST`) over SSH
#   - "local_dir"  : Reads recordings directly from `SDR_LOCAL_RECORDINGS` on the local filesystem/volume
SDR_CAPTURE_MODE=remote_ssh
SDR_REMOTE_HOST=sdr-server
SDR_GATEWAY=user@192.0.2.10
SDR_REMOTE_RECORDINGS=/var/lib/sdr/recordings
SDR_LOCAL_RECORDINGS=/home/user/blue-lodge/deploy/sdr-lab/media/p25_recordings

# --- 2. AI Inference & Endpoint Routing Mode ---
# Options for SDR_INFERENCE_MODE:
#   - "dedicated"    : Uses dedicated Whisper (:18090/:8090) + Gemma-4 E4B (:18080/:8080) endpoints
#   - "shared_local" : Shares the host node's primary Blue Lodge LLM_BASE_URL (:8080) and local Whisper
#   - "ipc_bus"      : Stages recordings and emits `sdr_call_staged` into `.george/ipc/event_bus.fifo`
SDR_INFERENCE_MODE=dedicated
SDR_TRANSCRIPTION_ENDPOINT=http://127.0.0.1:18090/inference
SDR_MULTIMODAL_ENDPOINT=http://127.0.0.1:18080/v1/chat/completions

# --- 3. Container & Model Settings ---
TRUNK_RECORDER_IMAGE=localhost/trunk-recorder:5.2.0-p25-lsm
WHISPER_GGML_MODEL=ggml-small-p25-a100-lora.bin
E4B_BASE_MODEL=gemma-4-E4B-it-qat-UD-Q4_K_XL.gguf
E4B_MMPROJ_MODEL=mmproj-gemma-4-E4B-it-F16.gguf
E4B_LORA_ADAPTER=gemma4-e4b-george-sdr-v2-SVD32.gguf

# --- 4. Storage Retention ---
SDR_LOCAL_RETENTION_DAYS=7
SDR_REMOTE_RETENTION_MINS=1440
TZ=America/Chicago

