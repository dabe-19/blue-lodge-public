# Honeydew Rewrite Router — REWRITE / KEEP verdict + reason
# Used by _agent_honeydew_rewrite() in lib/agent.sh
# Layer 1 constrained decoding for llama-server grammar param

root          ::= reasoning_block ws resp_root | ws resp_root

resp_root     ::= "<response>" ws json_root ws "</response>" | json_root

json_root     ::= "{" ws "\"classify\":" ws verdict_val "," ws "\"reason\":" ws string ws "}"

verdict_val   ::= "\"REWRITE\"" | "\"KEEP\""

# ── String rule: quote-preserving (default) ────────────────
# Allows escaped quotes, backslashes, and standard JSON escapes
# inside string values.
char          ::= [^"\\] | "\\" ["\\/bfnrt]
string        ::= "\"" char* "\""

reasoning_block ::= "<think>" reasoning_text "</think>"
                  | reasoning_text "</think>"
                  | "<|channel>thought" reasoning_text "<channel|>"
                  | reasoning_text "<channel|>"
                  | "[" [tT][hH][iI][nN][kK] "]" reasoning_text_bracket "[/" [tT][hH][iI][nN][kK] "]"
                  | reasoning_text_bracket "[/" [tT][hH][iI][nN][kK] "]"
                  | "[" [tT][hH][oO][uU][gG][hH][tT] "]" reasoning_text_bracket "[/" [tT][hH][oO][uU][gG][hH][tT] "]"
                  | reasoning_text_bracket "[/" [tT][hH][oO][uU][gG][hH][tT] "]"

reasoning_text    ::= [^<]*
reasoning_text_bracket ::= [^\[]*

ws            ::= [ \t\n]*
