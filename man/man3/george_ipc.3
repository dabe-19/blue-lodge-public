.TH FIFO_IPC 3 "October 2026" "George v3.0" "George Library Manual"
.SH NAME
fifo-ipc, george_ipc \- POSIX-Compliant Agentic Shell IPC SDK & Flow Control Library
.SH SYNOPSIS
.B source "$LODGE_DIR/lib/ipc/fifo_ipc.sh"
.sp
.SS Channel Lifecycle Functions
.BI "ipc_channel_open " "channel_id [window_size] [max_idle]"
.br
.BI "ipc_channel_close " "channel_id"
.br
.BI "ipc_channel_is_open " "channel_id"
.br
.BI "ipc_channel_list"
.br
.BI "ipc_status " "channel_id"
.br
.BI "ipc_channel_flush " "channel_id"

.SS Flow Control & Backpressure Functions
.BI "ipc_flow_acquire " "channel_id [timeout_seconds]"
.br
.BI "ipc_flow_grant " "channel_id [amount]"
.br
.BI "ipc_flow_send_ctrl " "channel_id command"
.br
.BI "ipc_flow_pause " "channel_id"
.br
