#!/bin/bash
# Automatically regenerate deterministic OKF knowledge graph after merges/pulls
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
if [ -f "$REPO_ROOT/lib/knowledge/okf.sh" ]; then
    LODGE_DIR="$REPO_ROOT" bash -c "source '$REPO_ROOT/lib/knowledge/okf.sh' && okf_sync --quiet" 2>/dev/null || true
fi
exit 0
