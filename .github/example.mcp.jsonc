// example.mcp.jsonc — copy to `.vscode/mcp.json` (workspace-scoped) or
// `~/.config/Code/User/mcp.json` (user-scoped) to enable the MCP servers the
// agent templates reference (`playwright/*`, `github/*`).
//
// IMPORTANT: this file is documentation. VS Code does NOT load `.jsonc` from
// the repo root automatically. The agent bootstrap trio reads this file to
// understand what shape an MCP config takes; the operator must copy/translate
// it into the host's actual MCP config location.
//
// References:
// - VS Code MCP docs:        https://code.visualstudio.com/docs/copilot/customization/mcp-servers
// - playwright-mcp:          https://github.com/microsoft/playwright-mcp
// - github-mcp-server:       https://github.com/github/github-mcp-server
{
  "servers": {
    // Playwright MCP — gives `tester` and `george` real-browser automation
    // (browser_navigate, browser_click, browser_snapshot, browser_evaluate, ...).
    // Wired into agent `tools:` lists as `playwright/*` (or per-tool grants).
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
      // Optional: pin a specific browser channel via env, e.g.
      // "env": { "PLAYWRIGHT_BROWSER": "chromium" }
    },

    // GitHub MCP — gives `git-manager` and `the-chronicler` PR/issue/branch
    // operations (create_issue, create_pull_request, list_issues, ...).
    // Wired into agent `tools:` lists as `github/*` (or per-tool grants).
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        // Provide via host secret store; do NOT commit a real token.
        // VS Code: configure via the input-prompt workflow in mcp.json,
        //   or via the environment variable on the launching shell.
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github-pat}"
      }
    }

    // Add other write-capable MCP servers here as needed
    // (filesystem, fetch, memory, postgres, etc.). Document each addition
    // in `.github/agents/templates/README.md` under "MCP server tokens".
  },

  // VS Code prompts the user for any `${input:<id>}` placeholder on first use
  // and caches the value securely. Define them here.
  "inputs": [
    {
      "id": "github-pat",
      "type": "promptString",
      "description": "GitHub Personal Access Token (repo + workflow scope)",
      "password": true
    }
  ]
}
