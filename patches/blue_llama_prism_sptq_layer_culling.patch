+        const int u1 = get_int_b4(bq8_1_chunk->qs, j * 2 + 1);
+
+        sumi = ggml_cuda_dp4a(u0, q0, sumi);
+        sumi = ggml_cuda_dp4a(u1, q1, sumi);
+    }
+
+    const float d8 = __low2float(bq8_1_chunk->ds);
+    return d2 * d8 * sumi;
