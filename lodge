    rest=$(echo "$args" | sed 's/^[^ ]* *//')

    case "$action" in
        generate|gen)
            pgp_generate_key ;;
        fingerprint|fp)
            pgp_fingerprint ;;
        sign)
            if [ -z "$rest" ] || [ "$rest" = "$action" ]; then
                ui_err "Usage: /pgp sign <message>"
                return 1
            fi
            local signed
            signed=$(pgp_sign_message "$rest")
            if [ $? -eq 0 ]; then
                echo ""
                echo "$signed"
                echo ""
            fi ;;
        verify)
            if [ -z "$rest" ] || [ "$rest" = "$action" ]; then
                ui_err "Usage: /pgp verify <signed-message>"
                ui_dim "Paste the full signed message including BEGIN/END markers"
                return 1
            fi
            pgp_verify_message "$rest" ;;
        export)
            pgp_export_public_key ;;
        pubkey|public|show)
            pgp_show_public_key ;;
        import)
            if [ -z "$rest" ] || [ "$rest" = "$action" ]; then
                ui_err "Usage: /pgp import <keyfile.asc>"
                return 1
            fi
            pgp_import_key "$rest" ;;
        keys|list)
            pgp_list_keys ;;
        signpost)
            # Sign and post to social media
            local platform text
            platform=$(echo "$rest" | awk '{print $1}')
            text=$(echo "$rest" | sed 's/^[^ ]* *//')
            if [ -z "$text" ] || [ "$text" = "$platform" ]; then
                # No platform specified — post to all
                text="$platform"
                pgp_sign_and_post "$text"
            else
                pgp_sign_and_post "$text" "$platform"
            fi ;;
        signfile)
            if [ -z "$rest" ] || [ "$rest" = "$action" ]; then
                ui_err "Usage: /pgp signfile <filepath>"
                return 1
            fi
            pgp_sign_file "$rest" ;;
        verifyfile)
            if [ -z "$rest" ] || [ "$rest" = "$action" ]; then
                ui_err "Usage: /pgp verifyfile <filepath> [sigfile]"
                return 1
            fi
            local fpath sig
            fpath=$(echo "$rest" | awk '{print $1}')
            sig=$(echo "$rest" | awk '{print $2}')
            if [ -n "$sig" ]; then
                pgp_verify_file "$fpath" "$sig"
            else
                pgp_verify_file "$fpath"
            fi ;;
        revoke)
            ui_warn "This will delete the current key and generate a new one."
            ui_warn "Anyone using the old public key will no longer verify messages."
            read -rp "  Continue? [y/N] " confirm
            if [[ "$confirm" =~ ^[Yy] ]]; then
                pgp_revoke_and_regenerate
            else
                ui_dim "Cancelled"
            fi ;;
        status|"") pgp_status ;;
        *)
            ui_info "Usage: /pgp <command>"
            ui_dim "  generate       — Create George's signing key"
            ui_dim "  fingerprint    — Show key fingerprint"
            ui_dim "  sign <msg>     — Sign a message (cleartext)"
            ui_dim "  verify <msg>   — Verify a signed message"
            ui_dim "  export         — Export public key to file"
            ui_dim "  pubkey         — Display the public key"
            ui_dim "  import <file>  — Import someone's public key"
            ui_dim "  keys           — List all keys in keyring"
            ui_dim "  signpost <msg> — Sign and post to social media"
            ui_dim "  signfile <f>   — Create detached signature for file"
            ui_dim "  verifyfile <f> — Verify a file's signature"
            ui_dim "  revoke         — Revoke key and regenerate"
            ui_dim "  status         — Show PGP signing status"
            ;;
    esac
}

# ── Recall (knowledge base search) ────────────────────────────
_cmd_recall() {
    local args="$1"

    # No args → show help
    if [ -z "$args" ]; then
        ui_section "Recall — FTS5 Knowledge Base"
        if ! recall_available 2>/dev/null; then
            ui_warn "sqlite3 with FTS5 not available"
            ui_dim "Install: apt install sqlite3"
            return 1
        fi
        recall_ensure_indexed
        ui_dim "Usage:"
        ui_dim "  /recall <query>     — Search all knowledge sources"
        ui_dim "  /recall stats       — Show index statistics"
        ui_dim "  /recall reindex     — Force reindex all sources"
        ui_dim "  /recall clear       — Clear the index"
        ui_dim "  /recall prefs       — List user preferences"
        ui_dim "  /recall prune <date|days> — Prune preferences before date"
        ui_dim "  /recall compact     — LLM-summarize user preferences"
        ui_dim "  /recall clearprefs  — Clear all user preferences"
        echo ""
        recall_stats
        return
    fi

    # Extract first word for subcommand check
    local first_word rest_args
    first_word=$(echo "$args" | awk '{print $1}')
    rest_args=$(echo "$args" | awk '{$1=""; print}' | sed 's/^ //')

    case "$first_word" in
        stats)
            ui_section "Recall Index Stats"
            recall_stats
            ;;
        reindex)
            ui_step "Reindexing knowledge base..."
            recall_clear
            recall_reindex
            ui_ok "Reindexed"
            recall_stats
            ;;
        clear)
            recall_clear
            ui_ok "Recall index cleared"
            ;;
        prefs)
            ui_section "User Preferences"
            recall_list_user_prefs
            ;;
        prune)
            if [ -z "$rest_args" ]; then
                ui_err "Usage: /recall prune <YYYY-MM-DD | days>"
                ui_dim "  /recall prune 2026-03-01   — prune before March 1"
                ui_dim "  /recall prune 30           — prune older than 30 days"
                return 1
            fi
            recall_prune_user_prefs "$rest_args"
            ;;
        compact)
            ui_section "Compacting User Preferences"
            recall_compact_user_prefs
            ;;
        clearprefs)
            recall_clear_user_prefs
            ;;
        *)
