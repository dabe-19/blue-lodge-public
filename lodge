# ── REPL ───────────────────────────────────────────────────────
_repl() {
    local workdir="$PWD"
    
    # History — load previous session commands into readline buffer
    local history_file="${LODGE_HISTORY_FILE:-$LODGE_DIR/.lodge_history}"
    touch "$history_file"
    history -r "$history_file" 2>/dev/null
    
    while true; do
        # Update project name on each prompt
        LODGE_PROJECT="$(basename "$PWD")"
        
        # Prompt
        local input
        
        # Clear any cancellation state from previous iteration
        _LODGE_CANCELLED=0
        _LODGE_IN_TASK=0
        rm -f "$_LODGE_CANCEL_FILE" 2>/dev/null
        
        local _prompt_str
        _prompt_str=$(ui_prompt_string)
        IFS= read -r -e -p "$_prompt_str" input
        
        # Empty input
        [ -z "$input" ] && continue
        
        # Save to file history and push to live readline buffer
        echo "$input" >> "$history_file"
        history -s "$input"
        
        # Trim
        input=$(echo "$input" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        
        # ── LLM backend health check ──────────────────────────
        # Verify the active backend is still alive before dispatching.
        # If llamacpp crashed (OOM, phone sleep), this restarts it or
        # falls back to Ollama in auto mode. Lightweight: 2s timeout.
        llm_repl_health_check 2>/dev/null
        
        # Auto-detect slashless commands: "model temp-ask" → "/model temp-ask"
        # Only if input doesn't already start with / and first word is a known command
        # that is NOT an ambiguous English verb ("write", "read", "test", etc.).
        # Ambiguous verbs require the explicit slash prefix to avoid misrouting
        # natural language like "read the docs and summarize" → /read.
        if ! [[ "$input" == /* ]]; then
            if commands_is_safe_auto_route "$input"; then
                ui_dim "(interpreting as /$input)"
                input="/$input"
            fi
        fi
        
        # Slash command?
        if commands_is_command "$input"; then
            local result
            commands_dispatch "$input" "$PWD"
            result=$?
            if [ "$result" -eq 99 ]; then
                ui_info "Goodbye."
                break
            elif [ "${_LODGE_CANCELLED:-0}" -eq 1 ]; then
                # Command was cancelled by Ctrl+C — don't fall through
                _LODGE_CANCELLED=0
            fi
            continue
        fi
        
        # Natural language → agent
        # All free-form input goes to agent_run (full soul, planning, tools).
        # For lightweight Q&A without actions, use /ask or /a explicitly.
        # This ensures George always gets his full personality injected
        # and can leverage journal, web search, and memory for answers.
        agent_run "$input" "$PWD"
    done
}

# ── Entry Point ────────────────────────────────────────────────
main() {
    # Verify dependencies
    local missing=()
    command -v curl  &>/dev/null || missing+=("curl")
    command -v jq    &>/dev/null || missing+=("jq")
    
    if [ ${#missing[@]} -gt 0 ]; then
        echo "Missing dependencies: ${missing[*]}"
        echo "Install: sudo apt install ${missing[*]}"
        exit 1
    fi
    
    # Register slash commands
    _register_commands
    commands_load_all
    
    # Initialize API config dir
    api_init 2>/dev/null
    
    # Security: initialize keyring and verify identity file integrity
    security_startup_check 2>/dev/null

    # Initialize secrets vault
    secrets_init 2>/dev/null

    # Index knowledge base for recall (if sqlite3 available)
    recall_ensure_indexed 2>/dev/null
    
    # Initialize model library (sets LODGE_MODEL from model slots)
    models_init

    # Re-apply persistent config overrides — models_init() sets sampling
    # params from the model registry, but the user may have customized
    # them via /model or /config and those should win.
    _llm_load_config --force

    # Load persisted provider harness setting
    _provider_load_harness

    # Start LLM backend (prefers llama-server, falls back to Ollama)
    if [ -n "${GEORGE_PROVIDER:-}" ]; then
        ui_ok "Provider harness: all LLM calls → $GEORGE_PROVIDER"
        local _h_model
        _h_model=$(provider_get_model "$GEORGE_PROVIDER" 2>/dev/null)
        [ -n "$_h_model" ] && ui_dim "  Model: $_h_model"
    elif [ "$LODGE_CLOUD_ONLY" -eq 1 ]; then
        ui_err "No local LLM backend available on this platform ($LODGE_PLATFORM)."
        ui_dim "  Set a cloud provider first:"
        ui_dim "    export GEORGE_PROVIDER=google   # or groq, openai, anthropic"
        ui_dim "    lodge"
        exit 1
    else
        ui_spinner_start "Starting LLM backend"
        if ! llm_ensure; then
            ui_spinner_stop
            ui_err "No LLM backend available."
            ui_dim "  Build llama-server: see docs/ADRENO_GPU_SETUP.md"
            ui_dim "  Or install Ollama:  curl -fsSL https://ollama.com/install.sh | sh"
            ui_dim "  Or use a cloud provider: /provider use google"
            exit 1
        fi
        ui_spinner_stop
    
        # Pre-load model weights (avoids cold-start delay on first query)
        ui_spinner_start "Loading model"
        llm_warmup 2>/dev/null
        ui_spinner_stop
    fi
    
    # Termux wake lock
    if _lodge_termux_api_ok && command -v termux-wake-lock &>/dev/null; then
        termux-wake-lock 2>/dev/null
    fi
    
    # Handle arguments
    # Apply journal decay on startup (cleans old entries)
    journal_init
    journal_apply_decay 2>/dev/null
    
    if [ $# -eq 0 ]; then
        # Interactive mode
        local _model_info="Model: $LODGE_MODEL"
        [ "${LODGE_SINGLE_MODEL:-0}" -eq 0 ] && _model_info="Primary: $(models_info "$LODGE_MODEL_PRIMARY" 2>/dev/null && echo "$_ME_KEY" || echo "$LODGE_MODEL_PRIMARY")"
        ui_header "George v${LODGE_VERSION}" "$_model_info | $(basename "$PWD")"
        
        # Journal-aware greeting
        journal_init
        local greeting
        greeting=$(journal_greeting)
        ui_dim "$greeting"
        ui_dim "Type /help for commands, or describe a task."
        echo ""
        _repl
        
        # End-of-session reflection — background so /quit exits instantly.
        # Disowned so it survives shell exit; keep_alive timeout frees RAM
        # after it finishes (no llm_unload needed for interactive mode).
        journal_reflect "Interactive session in $(basename "$PWD")" "$PWD" &
        disown 2>/dev/null
    elif [[ "$1" == /* ]]; then
        # Slash command mode
        commands_dispatch "$*" "$PWD"
    else
        # One-shot task mode
        agent_run "$*" "$PWD"
    fi
    
    # Release wake lock
    if _lodge_termux_api_ok && command -v termux-wake-unlock &>/dev/null; then
        termux-wake-unlock 2>/dev/null
    fi
    
    # Unload model on exit to free RAM (skip for interactive — background
    # journal_reflect still needs the model; keep_alive handles cleanup).
    if [ $# -gt 0 ]; then
        llm_unload 2>/dev/null
    fi
}

main "$@"
