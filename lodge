            echo ""
            printf "  %-22s %s\n" "Write mode:" "${LODGE_WRITE_MODE:-confirm}  (confirm|append|dangerous)"
            echo ""
            ui_dim "  (model) = using model defaults above. Overrides are absolute, not additive."
            ui_dim "  Example: /model temp-ask 0.3 sets ask temp to 0.3 (not model default + 0.3)"
            ui_dim "  Usage: /model <param> [value]"
            ui_dim "  Reset: /model reset" ;;
        # ── Help ─────────────────────────────────────────
        *)
            ui_info "Usage: /model [param] [value]"
            echo ""
            ui_dim "  Global defaults:"
            ui_dim "    temp N            — Temperature (current: $LLM_TEMPERATURE)"
            ui_dim "    repeat N          — Repeat penalty (current: $LLM_REPEAT_PENALTY)"
            ui_dim "    presence N        — Presence penalty (current: $LLM_PRESENCE_PENALTY)"
            echo ""
