# ── README self-review ─────────────────────────────────────────
_cmd_readme() {
    local args="$1"
    local section="${args#* }"

    if [[ "$section" == "$args" ]] || [ -z "$section" ]; then
        # No argument — show capabilities overview
        ui_section "George's README"
        if recall_available 2>/dev/null; then
            recall_ensure_indexed
            recall_self_review
        elif [ -f "$LODGE_DIR/README.md" ]; then
            head -120 "$LODGE_DIR/README.md"
        else
            ui_err "README.md not found"
        fi
    else
        # Search for a specific topic in the README
        ui_section "README: $section"
        if recall_available 2>/dev/null; then
            recall_ensure_indexed
            local result
            result=$(sqlite3 -separator '|' "$RECALL_DB" \
                "SELECT section, content FROM chunks WHERE source='readme' AND section LIKE '%${section//\'/\'\'}%' ORDER BY id;")
            if [ -n "$result" ]; then
                while IFS='|' read -r sec content; do
                    [ -z "$sec" ] && continue
                    printf "\n%b## %s%b\n" "$C_WHITE" "$sec" "$C_RESET"
                    echo "$content" | head -40
                done <<< "$result"
            else
                # Try search
                recall_search_pretty "$section" 5
            fi
        else
            grep -A 30 -i "$section" "$LODGE_DIR/README.md" | head -40
        fi
    fi
}

# ── PGP Signing ────────────────────────────────────────────────
_cmd_pgp() {
    local args="$1"
    local action
    action=$(echo "$args" | awk '{print $1}')
    local rest
    rest=$(echo "$args" | sed 's/^[^ ]* *//')

    case "$action" in
        generate|gen)
            pgp_generate_key ;;
        fingerprint|fp)
            pgp_fingerprint ;;
        sign)
            if [ -z "$rest" ] || [ "$rest" = "$action" ]; then
                ui_err "Usage: /pgp sign <message>"
                return 1
            fi
            local signed
            signed=$(pgp_sign_message "$rest")
            if [ $? -eq 0 ]; then
                echo ""
                echo "$signed"
                echo ""
            fi ;;
        verify)
            if [ -z "$rest" ] || [ "$rest" = "$action" ]; then
                ui_err "Usage: /pgp verify <signed-message>"
                ui_dim "Paste the full signed message including BEGIN/END markers"
                return 1
            fi
            pgp_verify_message "$rest" ;;
        export)
            pgp_export_public_key ;;
        pubkey|public|show)
            pgp_show_public_key ;;
        import)
            if [ -z "$rest" ] || [ "$rest" = "$action" ]; then
                ui_err "Usage: /pgp import <keyfile.asc>"
                return 1
            fi
            pgp_import_key "$rest" ;;
        keys|list)
            pgp_list_keys ;;
        signpost)
            # Sign and post to social media
            local platform text
            platform=$(echo "$rest" | awk '{print $1}')
            text=$(echo "$rest" | sed 's/^[^ ]* *//')
            if [ -z "$text" ] || [ "$text" = "$platform" ]; then
                # No platform specified — post to all
                text="$platform"
                pgp_sign_and_post "$text"
            else
                pgp_sign_and_post "$text" "$platform"
            fi ;;
        signfile)
            if [ -z "$rest" ] || [ "$rest" = "$action" ]; then
                ui_err "Usage: /pgp signfile <filepath>"
                return 1
            fi
            pgp_sign_file "$rest" ;;
        verifyfile)
            if [ -z "$rest" ] || [ "$rest" = "$action" ]; then
                ui_err "Usage: /pgp verifyfile <filepath> [sigfile]"
                return 1
            fi
            local fpath sig
            fpath=$(echo "$rest" | awk '{print $1}')
            sig=$(echo "$rest" | awk '{print $2}')
            if [ -n "$sig" ]; then
                pgp_verify_file "$fpath" "$sig"
            else
                pgp_verify_file "$fpath"
            fi ;;
        revoke)
            ui_warn "This will delete the current key and generate a new one."
            ui_warn "Anyone using the old public key will no longer verify messages."
            read -rp "  Continue? [y/N] " confirm
            if [[ "$confirm" =~ ^[Yy] ]]; then
                pgp_revoke_and_regenerate
            else
                ui_dim "Cancelled"
            fi ;;
        status|"") pgp_status ;;
        *)
            ui_info "Usage: /pgp <command>"
            ui_dim "  generate       — Create George's signing key"
            ui_dim "  fingerprint    — Show key fingerprint"
            ui_dim "  sign <msg>     — Sign a message (cleartext)"
            ui_dim "  verify <msg>   — Verify a signed message"
            ui_dim "  export         — Export public key to file"
            ui_dim "  pubkey         — Display the public key"
            ui_dim "  import <file>  — Import someone's public key"
            ui_dim "  keys           — List all keys in keyring"
            ui_dim "  signpost <msg> — Sign and post to social media"
            ui_dim "  signfile <f>   — Create detached signature for file"
            ui_dim "  verifyfile <f> — Verify a file's signature"
            ui_dim "  revoke         — Revoke key and regenerate"
            ui_dim "  status         — Show PGP signing status"
            ;;
    esac
}

