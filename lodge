# ── /slash — George's Custom Commands (The Magnum Opus) ────────
_cmd_slash() {
    local args="$1"
    local action
    action=$(echo "$args" | awk '{print $1}')
    local rest
    rest=$(echo "$args" | sed 's/^[^ ]* *//')

    case "$action" in
        # ── Management ─────────────────────────────────────────
        create|new)
            local name desc
            name=$(echo "$rest" | awk '{print $1}')
            desc=$(echo "$rest" | sed 's/^[^ ]* *//')
            [ "$desc" = "$name" ] && desc=""
            slash_create "$name" "$desc" ;;
        edit)
            local name new_desc
            name=$(echo "$rest" | awk '{print $1}')
            new_desc=$(echo "$rest" | sed 's/^[^ ]* *//')
            [ "$new_desc" = "$name" ] && new_desc=""
            slash_edit "$name" "$new_desc" ;;
        delete|rm|remove)
            slash_delete "$rest" ;;
        rename|mv)
            local old_name new_name
            old_name=$(echo "$rest" | awk '{print $1}')
            new_name=$(echo "$rest" | awk '{print $2}')
            slash_rename "$old_name" "$new_name" ;;
        list|ls|"")
            slash_list ;;
        # ── Inspection ─────────────────────────────────────────
        show|view|cat)
            slash_show "$rest" ;;
        test)
            local name test_args
            name=$(echo "$rest" | awk '{print $1}')
            test_args=$(echo "$rest" | sed 's/^[^ ]* *//')
            [ "$test_args" = "$name" ] && test_args=""
            slash_test "$name" "$test_args" ;;
        export)
            local name dest
            name=$(echo "$rest" | awk '{print $1}')
            dest=$(echo "$rest" | awk '{print $2}')
            slash_export "$name" "$dest" ;;
        # ── Help ───────────────────────────────────────────────
        help)
            ui_section "Slash Extensions (Magnum Opus)"
            ui_dim "  /slash                        — List all custom commands"
            ui_dim "  /slash create <name> <desc>   — Create a new command (LLM-assisted)"
            ui_dim "  /slash <name> [args]          — Run a custom command"
            ui_dim "  /slash test <name> [args]     — Test a custom command"
            ui_dim "  /slash show <name>            — View source code"
            ui_dim "  /slash edit <name> [new desc] — Edit / re-generate"
            ui_dim "  /slash delete <name>          — Delete a custom command"
            ui_dim "  /slash rename <old> <new>     — Rename a command"
            ui_dim "  /slash export <name> [path]   — Export as standalone script"
            echo ""
            ui_dim "Custom commands have full access to all lodge libraries,"
            ui_dim "base commands, sandboxes, containers, and other /slash commands."
            echo "" ;;
        # ── Default: execute a custom command ──────────────────
        *)
            # action IS the command name
            local cmd_name="$action"
            local cmd_args="$rest"
            [ "$cmd_args" = "$action" ] && cmd_args=""
            if [ -f "$SLASH_DIR/${cmd_name}.sh" ] 2>/dev/null; then
                slash_run "$cmd_name" "$cmd_args" "${2:-.}"
            else
                ui_err "Unknown slash command or subcommand: '$cmd_name'"
                ui_dim "Run /slash list to see custom commands"
                ui_dim "Run /slash help for usage"
            fi ;;
    esac
}

# ── Transcript Management ──────────────────────────────────────
_cmd_transcript() {
    local sub="$1"
    local workdir="${2:-.}"

    case "$sub" in
        list|ls|"")
            ui_section "Recent Transcripts"
            transcript_list "$workdir" 15
            ;;
        last|latest|recent)
            local last
            last=$(transcript_last "$workdir")
            if [ -z "$last" ]; then
                ui_warn "No transcripts found"
                return 1
            fi
            ui_info "Latest: $last"
            echo ""
            cat "$last"
            ;;
        path)
            if transcript_active; then
                ui_ok "Active transcript: $(transcript_path)"
            else
                ui_dim "No transcript active"
            fi
            ;;
        show)
            # Show a specific transcript (second arg)
            local target
            target=$(echo "$sub" | sed 's/^show *//')
            if [ -z "$target" ] || [ "$target" = "show" ]; then
                # No argument — show latest
                target=$(transcript_last "$workdir")
            fi
            if [ -z "$target" ] || [ ! -f "$target" ]; then
                # Try matching by partial filename
                local dir="$workdir/.george/transcripts"
                if [ -d "$dir" ]; then
                    target=$(ls -1t "$dir"/*.md 2>/dev/null | head -1)
                fi
            fi
            if [ -n "$target" ] && [ -f "$target" ]; then
                cat "$target"
            else
                ui_warn "No transcript found"
                return 1
            fi
            ;;
        *)
            ui_info "Usage: /transcript [list|last|path|show]"
            ui_dim "  list  — Show recent transcripts"
            ui_dim "  last  — Display the most recent transcript"
            ui_dim "  path  — Show path to active transcript"
            ui_dim "  show  — Display latest transcript content"
            ;;
    esac
}

