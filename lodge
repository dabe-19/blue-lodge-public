            ui_dim "  (temp-X, repeat-X, presence-X where X is ask|agent|router|journal|tool)"
            ui_dim "    temp-ask N        — Ask temperature (current: $LLM_TEMP_ASK)"
            ui_dim "    presence-ask N    — Ask presence penalty (current: $LLM_PRESENCE_ASK)"
            ui_dim "    temp-router N     — Router temperature (current: $LLM_TEMP_ROUTER)"
