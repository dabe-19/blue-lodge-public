_cmd_gpu() {
    local new_layers="${1:-}"

    # No argument — show current setting
    if [ -z "$new_layers" ]; then
        ui_section "GPU Layers"
        printf "  %-22s %s\n" "Current:" "$LLAMA_CPP_GPU_LAYERS"
        printf "  %-22s %s\n" "Backend:" "$(_llm_detect_backend 2>/dev/null || echo "unknown")"
        echo ""
        ui_dim "  Usage: /gpu <layers>   — Set GPU offload layers and restart"
        ui_dim ""
        ui_dim "  /gpu 0        CPU only (default — fastest and correct on Adreno 830)"
        ui_dim "  /gpu 10       Offload 10 layers (partial GPU — test for Vulkan bugs)"
        ui_dim "  /gpu 27       All layers GPU (crashes or gibberish on Adreno 830)"
        ui_dim ""
        ui_dim "  ⚠ Adreno 830 Vulkan compute produces corrupted output."
        ui_dim "    CPU with NEON/DOTPROD is faster (~28 tok/s vs ~14 tok/s GPU)."
        ui_dim "    Only use /gpu >0 to re-test after driver updates."
        ui_dim ""
        ui_dim "  If llama-server is running, it will be restarted automatically."
        return 0
    fi

    # Validate: must be a non-negative integer
    if ! [[ "$new_layers" =~ ^[0-9]+$ ]]; then
        ui_err "GPU layers must be a non-negative integer (got: $new_layers)"
        return 1
    fi

    local old_layers="$LLAMA_CPP_GPU_LAYERS"
    LLAMA_CPP_GPU_LAYERS="$new_layers"
    ui_ok "GPU layers: $old_layers → $new_layers"

    # If llama-server is running, restart it with new setting
    if [ -f "$_LLAMA_CPP_PID_FILE" ]; then
        local _pid
        _pid=$(cat "$_LLAMA_CPP_PID_FILE" 2>/dev/null)
        if kill -0 "$_pid" 2>/dev/null; then
            ui_info "Restarting llama-server with $new_layers GPU layers..."
            local _current_model="$LLAMA_CPP_MODEL"
            _llm_stop_llamacpp_server "--quiet"

            # Chat template: --jinja uses the GGUF-embedded Jinja2 template,
            # so no per-model template resolution is needed.
            if _llm_start_llamacpp_server "$_current_model"; then
                local _health _status
                _health=$(curl -sf "$LLAMA_CPP_URL/health" 2>/dev/null)
                _status=$(echo "$_health" | jq -r '.status // "unknown"' 2>/dev/null)
                ui_dim "  Health: $_status"
            fi
        fi
    else
        ui_dim "  No llama-server running. Setting will apply on next /backend start."
    fi
}
