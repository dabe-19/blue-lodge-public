    local rest
    rest=$(echo "$args" | sed 's/^[^ ]* *//')
    
    case "$action" in
        list|ls)   sandbox_list ;;
        new|create)
            local name type
            name=$(echo "$rest" | awk '{print $1}')
            type=$(echo "$rest" | awk '{print $2}')
            sandbox_create "$name" "${type:-shell}" ;;
        build)     sandbox_build "$rest" ;;
        test)      sandbox_test "$rest" ;;
        rm|remove) sandbox_remove "$rest" ;;
        clone)
            local url name
            url=$(echo "$rest" | awk '{print $1}')
            name=$(echo "$rest" | awk '{print $2}')
            sandbox_clone "$url" "$name" ;;
