            fi
            ;;
        verify-token)
            local file token
            file=$(echo "$rest" | awk '{print $1}')
            token=$(echo "$rest" | awk '{print $2}')
            if [ -n "$file" ] && [ -n "$token" ]; then
                if security_verify_share_token "$file" "$token"; then
                    ui_ok "Token valid — file is authentic ✓"
                else
                    ui_err "Token invalid — file may have been tampered with"
                fi
            else
                ui_info "Usage: /security verify-token <filepath> <token>"
