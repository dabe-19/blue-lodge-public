# ── REPL ───────────────────────────────────────────────────────
_repl() {
    local workdir="$PWD"
    
    # History — load previous session commands into readline buffer
    local history_file="$HOME/.lodge_history"
    touch "$history_file"
    history -r "$history_file" 2>/dev/null
    
    while true; do
        # Update project name on each prompt
        LODGE_PROJECT="$(basename "$PWD")"
        
        # Prompt
        local input
        
        # Clear any cancellation state from previous iteration
        _LODGE_CANCELLED=0
        _LODGE_IN_TASK=0
        rm -f "$_LODGE_CANCEL_FILE" 2>/dev/null
        
        ui_prompt
        IFS= read -r -e input
        
        # Empty input
        [ -z "$input" ] && continue
        
        # Save to file history and push to live readline buffer
        echo "$input" >> "$history_file"
        history -s "$input"
        
        # Trim
        input=$(echo "$input" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        
        # Slash command?
        if commands_is_command "$input"; then
            local result
            commands_dispatch "$input" "$PWD"
            result=$?
            if [ "$result" -eq 99 ]; then
                ui_info "Goodbye."
                break
            elif [ "$result" -ne 0 ] && [ "$result" -ne 1 ]; then
                : # command handled its own errors
            elif [ "$result" -eq 1 ]; then
                # Not found — try as agent task
                ui_warn "Unknown command. Treating as task..."
                agent_run "${input#/}" "$PWD"
            fi
            continue
        fi
        
        # Natural language → agent
        # Questions → lightweight ask path (lean prompt, fast on phone)
        # Tasks → full plan→execute path (larger prompt, slower)
        local word_count
        word_count=$(echo "$input" | wc -w)
        
        if [[ "$input" == *"?" ]] || [[ "$input" == *"?)" ]] || { [ "$word_count" -le 3 ] && ! [[ "$input" == *"/"* ]]; }; then
            # Ends with ? → question. ≤3 words without / → greeting/short question.
            agent_ask "$input" "$PWD"
        else
            # Looks like a task
            agent_run "$input" "$PWD"
        fi
    done
}

# ── Entry Point ────────────────────────────────────────────────
main() {
    # Verify dependencies
    local missing=()
    command -v curl  &>/dev/null || missing+=("curl")
    command -v jq    &>/dev/null || missing+=("jq")
    
    if [ ${#missing[@]} -gt 0 ]; then
        echo "Missing dependencies: ${missing[*]}"
        echo "Install: sudo apt install ${missing[*]}"
        exit 1
    fi
    
    # Register slash commands
    _register_commands
    commands_load_all
    
    # Initialize API config dir
    api_init 2>/dev/null
    
    # Security: initialize keyring and verify identity file integrity
    security_startup_check 2>/dev/null

    # Initialize secrets vault
    secrets_init 2>/dev/null

    # Index knowledge base for recall (if sqlite3 available)
    recall_ensure_indexed 2>/dev/null
    
    # Check LLM
    if ! llm_ensure; then
        ui_err "Cannot connect to Ollama. Is it running?"
        ui_dim "Start with: ollama serve"
        exit 1
    fi
    
    # Pre-load model weights (avoids cold-start delay on first query)
    ui_spinner_start "Loading model"
    llm_warmup 2>/dev/null
    ui_spinner_stop
    
    # Termux wake lock
    if command -v termux-wake-lock &>/dev/null; then
        termux-wake-lock 2>/dev/null
    fi
    
    # Handle arguments
    # Apply journal decay on startup (cleans old entries)
    journal_init
    journal_apply_decay 2>/dev/null
    
    if [ $# -eq 0 ]; then
        # Interactive mode
        ui_header "George v${LODGE_VERSION}" "Model: $LODGE_MODEL | $(basename "$PWD")"
        
        # Journal-aware greeting
        journal_init
        local greeting
        greeting=$(journal_greeting)
        ui_dim "$greeting"
        ui_dim "Type /help for commands, or describe a task."
        echo ""
        _repl
        
        # End-of-session reflection
        journal_reflect "Interactive session in $(basename "$PWD")" "$PWD"
    elif [[ "$1" == /* ]]; then
        # Slash command mode
        commands_dispatch "$*" "$PWD"
    else
        # One-shot task mode
        agent_run "$*" "$PWD"
    fi
    
    # Release wake lock
    if command -v termux-wake-unlock &>/dev/null; then
        termux-wake-unlock 2>/dev/null
    fi
    
    # Unload model on exit to free RAM
    llm_unload 2>/dev/null
}

main "$@"
