                if security_decrypt_file "$rest"; then
                    ui_ok "Decrypted: $rest"
                else
                    ui_err "Decryption failed"
                fi
            else
                ui_info "Usage: /security decrypt <filepath>"
            fi
            ;;
        share)
            if [ -n "$rest" ] && [ -f "$rest" ]; then
                local token
                token=$(security_generate_share_token "$rest")
                if [ -n "$token" ]; then
                    ui_ok "Share token for $(basename "$rest"):"
                    ui_dim "  $token"
                    ui_dim "  Share this token with someone you trust."
