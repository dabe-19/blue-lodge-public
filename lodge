#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# ⌂ George — Mobile-First Coding Agent (Blue Lodge)
# ═══════════════════════════════════════════════════════════════
# A lightweight agentic shell powered by local LLMs via Ollama.
# Designed for Galaxy Fold 7 / Termux (native or proot) on ARM.
#
# Usage:
#   lodge                    # Interactive mode
#   lodge "task description"  # One-shot task
#   lodge /init myapp rust   # Run a slash command
# ═══════════════════════════════════════════════════════════════
set -uo pipefail

export LODGE_VERSION="0.1.0"
# Auto-detect LODGE_DIR from script location if not set
if [ -z "${LODGE_DIR:-}" ]; then
    _LODGE_SELF="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
    export LODGE_DIR="$(cd "$(dirname "$_LODGE_SELF")" && pwd)"
fi
export LODGE_PROJECT="${LODGE_PROJECT:-$(basename "$PWD")}"

# ── Platform detection ─────────────────────────────────────────
# Detect constrained environments (iSH/Alpine on iOS, Termux, etc.)
# so we can gate local-LLM features that require native binaries.
LODGE_PLATFORM="linux"
LODGE_CLOUD_ONLY=0
if [ -f /proc/ish/version ] || ([ -f /etc/os-release ] && grep -qi 'alpine' /etc/os-release 2>/dev/null && [ "$(uname -m)" = "i686" ]); then
    LODGE_PLATFORM="ish"
    # iSH can't run Ollama/llama-server (i686 emulation, no native binaries)
    [ -z "${GEORGE_PROVIDER:-}" ] && LODGE_CLOUD_ONLY=1
elif [ -n "${TERMUX_VERSION:-}" ] || [ -d /data/data/com.termux ]; then
    LODGE_PLATFORM="termux"
fi
export LODGE_PLATFORM LODGE_CLOUD_ONLY

# ── George's isolated environment (everything lives inside LODGE_DIR) ──
export GEORGE_CONFIG_DIR="${GEORGE_CONFIG_DIR:-$LODGE_DIR/.george}"
export LODGE_SANDBOXES="${LODGE_SANDBOXES:-$LODGE_DIR/.sandboxes}"
export LODGE_HISTORY_FILE="${LODGE_HISTORY_FILE:-$LODGE_DIR/.lodge_history}"

# ── Source Libraries ───────────────────────────────────────────
source "$LODGE_DIR/lib/ui.sh"
source "$LODGE_DIR/lib/llm.sh"
source "$LODGE_DIR/lib/memory.sh"
source "$LODGE_DIR/lib/tools.sh"
source "$LODGE_DIR/lib/agent.sh"
source "$LODGE_DIR/lib/commands.sh"
source "$LODGE_DIR/lib/sandbox.sh"
source "$LODGE_DIR/lib/container.sh"
source "$LODGE_DIR/lib/api.sh"
source "$LODGE_DIR/lib/social.sh"
source "$LODGE_DIR/lib/providers.sh"
source "$LODGE_DIR/lib/web.sh"
source "$LODGE_DIR/lib/backup.sh"
source "$LODGE_DIR/lib/journal.sh"
source "$LODGE_DIR/lib/security.sh"
source "$LODGE_DIR/lib/recall.sh"
source "$LODGE_DIR/lib/secrets.sh"
source "$LODGE_DIR/lib/gsuite.sh"
source "$LODGE_DIR/lib/wallet.sh"
source "$LODGE_DIR/lib/pgp.sh"
source "$LODGE_DIR/lib/phone.sh"
source "$LODGE_DIR/lib/slash.sh"
source "$LODGE_DIR/lib/vitals.sh"
source "$LODGE_DIR/lib/email.sh"
source "$LODGE_DIR/lib/git.sh"
source "$LODGE_DIR/lib/transcript.sh"

# ── Graceful Cancellation ─────────────────────────────────────
# Tracks whether we're in task execution so Ctrl+C behaves smartly:
# - During LLM generation → kill curl + spinner, return to prompt
# - During REPL idle → exit cleanly
_LODGE_IN_TASK=0
_LODGE_CANCELLED=0
_LODGE_CANCEL_FILE="${TMPDIR:-/tmp}/.lodge-cancel-$$"

_lodge_cleanup() {
    # Write cancel file (visible to all subshells, unlike variables)
    touch "$_LODGE_CANCEL_FILE" 2>/dev/null

    # Stop spinner if running (fast — just kill + clear line)
    ui_spinner_stop 2>/dev/null

    # Kill any curl processes talking to LLM backends (works through subshells)
    # This is the ONLY reliable way to kill curl inside nested $() captures.
    # MUST be non-blocking — no waiting, no HTTP calls.
    #
    # Ollama endpoints:
    pkill -f "curl.*api/generate" 2>/dev/null
    pkill -f "curl.*api/chat" 2>/dev/null
    pkill -f "timeout.*curl.*api" 2>/dev/null
    # llama-server endpoint — killing curl closes the TCP connection,
    # which tells llama-server to abort the active inference slot.
    # Without this, the server keeps computing tokens nobody is reading
    # and the phone stays hot long after Ctrl+C.
    pkill -f "curl.*v1/chat/completions" 2>/dev/null
    pkill -f "timeout.*curl.*v1/chat" 2>/dev/null

    # Also kill curl via tracked PID (set by FIFO-based streaming)
    if [ -n "${_LLM_CURL_PID:-}" ] && kill -0 "$_LLM_CURL_PID" 2>/dev/null; then
        kill "$_LLM_CURL_PID" 2>/dev/null
    fi
    _LLM_CURL_PID=""
    _LLM_ACTIVE=0

    # Clean up FIFO files left by interrupted streams
    rm -f "${TMPDIR:-/tmp}"/.lodge-fifo-*-$$ 2>/dev/null

    if [ "$_LODGE_IN_TASK" -eq 1 ]; then
        _LODGE_CANCELLED=1
        echo ""
        ui_warn "Cancelled by user"
        return 0
    else
        # Not in a task: clean exit
        echo ""
        ui_info "Interrupted. Exiting..."
        rm -f "$_LODGE_CANCEL_FILE"
        if _lodge_termux_api_ok && command -v termux-wake-unlock &>/dev/null; then
            termux-wake-unlock 2>/dev/null
        fi
        exit 0
    fi
}

# ── Exit cleanup — always runs, even on normal exit ────────────
# Kills orphan curl processes and cleans temp files so the phone
# doesn't keep computing after Lodge exits (close Termux, /quit, etc.)
_lodge_exit_cleanup() {
    # Kill any leftover curl → LLM processes
    pkill -f "curl.*v1/chat/completions" 2>/dev/null || true
    pkill -f "curl.*api/generate" 2>/dev/null || true
    pkill -f "curl.*api/chat" 2>/dev/null || true
    # Clean temp files
    rm -f "${TMPDIR:-/tmp}"/.lodge-fifo-*-$$ 2>/dev/null
    rm -f "${TMPDIR:-/tmp}"/.lodge-cancel-$$ 2>/dev/null
    rm -f "${TMPDIR:-/tmp}"/.lodge-ft-$$ 2>/dev/null
    rm -f "${TMPDIR:-/tmp}"/.lodge-gen-tok-$$ 2>/dev/null
    rm -f "${TMPDIR:-/tmp}"/.lodge-chat-tok-$$ 2>/dev/null
    rm -f "${TMPDIR:-/tmp}"/.lodge-curl-pid-$$ 2>/dev/null
}

trap '_lodge_cleanup' INT TERM
trap '_lodge_exit_cleanup' EXIT

# ── Register Built-in Slash Commands ──────────────────────────
_cmd_init() {
    source "$LODGE_DIR/commands/init.sh"
    cmd_init "$@"
}
_cmd_plan() {
    local task="$1"
    local workdir="${2:-.}"
    local plan
    plan=$(agent_plan "$task" "$workdir")
    echo ""
}
_cmd_q() {
    agent_ask "$1" "${2:-.}"
}
_cmd_ask() {
    # /ask is an agent-only command — George asks the USER a question
    # during task execution. From the REPL, users should use /q instead.
    if [ -z "$1" ]; then
        ui_err "Usage: /ask <question>  (agent-only — asks the user)"
        ui_info "Did you mean /q? Use /q <question> for quick questions."
        return 1
    fi
    # When invoked from the inner loop, the question is the argument.
    # Read the user's answer from /dev/tty and emit it on stdout
    # so commands_dispatch captures it in the action log.
    echo ""
    printf "  %b George asks: %b%s%b\n" "$C_LODGE" "$C_CYAN" "$1" "$C_RESET" > /dev/tty 2>/dev/null
    echo "" > /dev/tty 2>/dev/null
    printf "  %b> %b" "$C_BOLD" "$C_RESET" > /dev/tty 2>/dev/null
    local answer
    read -r answer < /dev/tty
    if [ -z "$answer" ]; then
        echo "(no answer provided)"
        return 0
    fi
    echo "$answer"
}
_cmd_respond() {
    local text="$1"
    if [ -z "$text" ]; then
        ui_err "Nothing to respond with"
        return 1
    fi
    # Expand LLM escape sequences (\n → newline, etc.)
    text=$(ui_expand_escapes "$text")
    echo ""
    # Render with markdown-lite formatting (headers, lists, code blocks)
    ui_render_response "$text"
    echo ""
    # Emit raw text to stdout so agent inner loop captures it in action log
    echo "$text"
}
_cmd_think() {
    local arg="$1"
    case "$arg" in
        on|1|enable)
            LODGE_NOTHINK=0
            LODGE_THINK=1
            LODGE_THINK_STREAM=1
            ui_ok "Thinking ON — reasoning enabled, dimmed stream" ;;
        off|0|disable|nothink|skip)
            LODGE_NOTHINK=1
            LODGE_THINK=0
            ui_ok "Thinking OFF — reasoning disabled (/no_think injected)" ;;
        bright|loud|2)
            LODGE_NOTHINK=0
            LODGE_THINK=1
            LODGE_THINK_STREAM=2
            ui_ok "Thinking ON — bright stream (cyan)" ;;
        dim|dimmed|quiet)
            LODGE_NOTHINK=0
            LODGE_THINK=1
            LODGE_THINK_STREAM=1
            ui_ok "Thinking ON — dimmed stream" ;;
        hide|hidden|silent)
            LODGE_NOTHINK=0
            LODGE_THINK=1
            LODGE_THINK_STREAM=0
            ui_ok "Thinking ON — hidden (reasoning happens, not shown)" ;;
        test|diag|diagnose|debug)
            ui_info "Think display diagnostics"
            ui_dim "  LODGE_THINK=$LODGE_THINK  LODGE_THINK_STREAM=$LODGE_THINK_STREAM  LODGE_NOTHINK=$LODGE_NOTHINK"
            ui_dim "  LODGE_MODEL=$LODGE_MODEL"
            local _has_t=0 _flag_t=0
            models_current_has_thinking && _has_t=1
            models_supports_think_flag "$LODGE_MODEL" 2>/dev/null && _flag_t=1
            ui_dim "  has_thinking=$_has_t  supports_think_flag=$_flag_t"
            if [ "$_has_t" -eq 1 ] && [ "$_flag_t" -eq 1 ]; then
                ui_dim "  Mode: native (.thinking JSON field, think:true sent)"
            elif [ "$_has_t" -eq 1 ] && [ "$_flag_t" -eq 0 ]; then
                ui_dim "  Mode: inline (<think> tags in .response, think:true NOT sent)"
            else
                ui_dim "  Mode: non-thinking model (no think parsing)"
            fi
            ui_dim "  Tip: /debug on to see parser events during generation"
            ui_dim "  Tip: /think bright for maximum visibility (cyan text)" ;;
        "")
            # No arg: show current status
            local _status="UNKNOWN"
            if [ "${LODGE_NOTHINK:-0}" -eq 1 ]; then
                _status="OFF (reasoning disabled)"
            elif [ "${LODGE_THINK:-1}" -eq 1 ]; then
                case "${LODGE_THINK_STREAM:-1}" in
                    2) _status="ON — bright (cyan)" ;;
                    1) _status="ON — dimmed" ;;
                    0) _status="ON — hidden" ;;
                esac
            else
                _status="ON — display hidden"
            fi
            ui_info "Think status: $_status"
            ui_dim "  /think on     — enable reasoning (dimmed display)"
            ui_dim "  /think off    — disable reasoning entirely"
            ui_dim "  /think bright — show thinking in cyan"
            ui_dim "  /think dim    — show thinking in faint text"
            ui_dim "  /think hide   — reason but don't display"
            ui_dim "  /think test   — diagnostics" ;;
        *)
            ui_info "Usage: /think [on|off|bright|dim|hide|test]"
            ui_dim "  on     — enable reasoning + dimmed display"
            ui_dim "  off    — disable reasoning entirely"
            ui_dim "  bright — show thinking in cyan with borders"
            ui_dim "  dim    — show thinking in faint text"
            ui_dim "  hide   — reason but don't stream to screen"
            ui_dim "  test   — show think parser diagnostics" ;;
    esac
}
_cmd_debug() {
    local arg="$1"
    case "$arg" in
        on|1)
            LODGE_DEBUG=1
            _llm_save_config
            ui_ok "Debug mode ON — timers + token counts per LLM call" ;;
        off|0)
            LODGE_DEBUG=0
            _llm_save_config
            ui_ok "Debug mode OFF" ;;
        "")
            # Toggle
            if [ "${LODGE_DEBUG:-0}" -eq 0 ]; then
                LODGE_DEBUG=1
                _llm_save_config
                ui_ok "Debug mode ON — timers + token counts per LLM call"
            else
                LODGE_DEBUG=0
                _llm_save_config
                ui_ok "Debug mode OFF"
            fi ;;
        *)
            ui_info "Usage: /debug [on|off]"
            ui_dim "  on/off   — toggle debug output (current: $([ "${LODGE_DEBUG:-0}" -eq 1 ] && echo ON || echo OFF))"
            ui_dim "  (no arg) — toggle"
            ui_dim ""
            ui_dim "  When ON, each LLM call prints elapsed time and token counts"
            ui_dim "  (input/output). A summary is printed after each task completes." ;;
    esac
}
_cmd_config() {
    local args="$1"
    local action
    action=$(echo "$args" | awk '{print $1}')

    case "$action" in
        ""|show)
            ui_section "Persistent Configuration"
            if [ -f "$_LLM_CONFIG_FILE" ]; then
                ui_dim "  File: $_LLM_CONFIG_FILE"
                echo ""
                while IFS= read -r _line; do
                    if [[ "$_line" =~ ^# ]]; then
                        ui_dim "  $_line"
                    elif [[ -n "$_line" ]]; then
                        printf "  %s\n" "$_line"
                    fi
                done < "$_LLM_CONFIG_FILE"
            else
                ui_dim "  No config file yet. Use /config save to create one."
            fi ;;
        save)
            _llm_save_config
            ui_ok "Config saved to $_LLM_CONFIG_FILE"
            local _count
            _count=$(grep -c '^[A-Z]' "$_LLM_CONFIG_FILE" 2>/dev/null)
            _count=${_count:-0}
            ui_dim "  $_count settings persisted" ;;
        reset)
            rm -f "$_LLM_CONFIG_FILE" 2>/dev/null
            ui_ok "Config file removed — defaults will apply on next launch" ;;
        edit)
            if [ -f "$_LLM_CONFIG_FILE" ]; then
                local _editor="${EDITOR:-vi}"
                "$_editor" "$_LLM_CONFIG_FILE"
                # Reload after edit
                _llm_load_config
                ui_ok "Config reloaded"
            else
                ui_warn "No config file yet. Use /config save first."
            fi ;;
        *)
            ui_info "Usage: /config [show|save|reset|edit]"
            echo ""
            ui_dim "  show   — Display current persistent settings (default)"
            ui_dim "  save   — Write current settings to $_LLM_CONFIG_FILE"
            ui_dim "  reset  — Remove config file (revert to defaults)"
            ui_dim "  edit   — Open config in \$EDITOR"
            ui_dim ""
            ui_dim "  Settings auto-save when changed via /backend, /debug, /model."
            ui_dim "  Environment variables always override config file values." ;;
    esac
}
_cmd_backend() {
    local args="$1"
    local action
    action=$(echo "$args" | awk '{print $1}')
    local arg2
    arg2=$(echo "$args" | awk '{print $2}')

    case "$action" in
        ""|status)
            local detected
            detected=$(_llm_detect_backend 2>/dev/null)
            ui_section "LLM Backend"
            printf "  %-22s %s\n" "Preference:" "$LLM_BACKEND  (default: auto)"
            printf "  %-22s %s\n" "Active backend:" "$detected"
            printf "  %-22s %s\n" "Ollama URL:" "$OLLAMA_URL"
            printf "  %-22s %s\n" "llama-server URL:" "$LLAMA_CPP_URL"
            echo ""
            # Show health of both backends
            local ollama_status="unreachable"
            curl -sf --max-time 2 "$OLLAMA_URL/api/tags" &>/dev/null && ollama_status="running"
            local llamacpp_status="unreachable"
            local llamacpp_health
            llamacpp_health=$(curl -sf --max-time 2 "$LLAMA_CPP_URL/health" 2>/dev/null)
            if [ $? -eq 0 ]; then
                llamacpp_status=$(echo "$llamacpp_health" | jq -r '.status // "unknown"' 2>/dev/null)
            fi
            ui_section "Health"
            printf "  %-22s %s\n" "Ollama:" "$ollama_status"
            printf "  %-22s %s\n" "llama-server:" "$llamacpp_status"
            # Show actual vs configured GPU layers for running llama-server
            if [ "$llamacpp_status" != "unreachable" ]; then
                local _srv_pid_status _actual_ngl="?"
                _srv_pid_status=$(pgrep -f "llama-server.*--port" 2>/dev/null | head -1)
                if [ -n "$_srv_pid_status" ]; then
                    if [ -f "/proc/$_srv_pid_status/cmdline" ]; then
                        _actual_ngl=$(tr '\0' ' ' < "/proc/$_srv_pid_status/cmdline" 2>/dev/null \
                            | sed -n 's/.*-ngl[[:space:]]\{1,\}\([0-9]\{1,\}\).*/\1/p' || echo "?")
                    fi
                    [ "$_actual_ngl" = "?" ] && _actual_ngl=$(ps -p "$_srv_pid_status" -o args= 2>/dev/null \
                        | sed -n 's/.*-ngl[[:space:]]\{1,\}\([0-9]\{1,\}\).*/\1/p' || echo "?")
                fi
                local _ngl_match=""
                [ "$_actual_ngl" != "?" ] && [ "$_actual_ngl" != "$LLAMA_CPP_GPU_LAYERS" ] && _ngl_match=" ⚠ MISMATCH (config=$LLAMA_CPP_GPU_LAYERS)"
                printf "  %-22s %s%s\n" "GPU layers (running):" "$_actual_ngl" "$_ngl_match"
            fi
            ;;
        auto|ollama|llamacpp|llama-cpp)
            LLM_BACKEND="$action"
            _LLM_BACKEND_CACHE=""  # Clear cache to force re-detection
            _llm_save_config
            local new_backend
            new_backend=$(_llm_detect_backend 2>/dev/null)
            ui_ok "Backend preference set to '$action' → active: $new_backend" ;;
        url)
            if [ -z "$arg2" ]; then
                ui_info "Current URLs:"
                ui_dim "  Ollama:       $OLLAMA_URL"
                ui_dim "  llama-server: $LLAMA_CPP_URL"
                ui_dim ""
                ui_dim "  Usage: /backend url ollama <url>"
                ui_dim "         /backend url llamacpp <url>"
            else
                local arg3
                arg3=$(echo "$args" | awk '{print $3}')
                case "$arg2" in
                    ollama)
                        OLLAMA_URL="${arg3:-http://127.0.0.1:11434}"
                        _LLM_BACKEND_CACHE=""
                        ui_ok "Ollama URL set to: $OLLAMA_URL" ;;
                    llamacpp|llama-cpp)
                        LLAMA_CPP_URL="${arg3:-http://127.0.0.1:8080}"
                        _LLM_BACKEND_CACHE=""
                        ui_ok "llama-server URL set to: $LLAMA_CPP_URL" ;;
                    *)
                        ui_err "Unknown backend: $arg2 (use 'ollama' or 'llamacpp')" ;;
                esac
            fi ;;
        start)
            # Start llama-server with configured model
            # Start llama-server with configured model
            # Resolve model: registry key → Ollama model name → direct GGUF path
            local _model_path="$LLAMA_CPP_MODEL"
            if [ -z "$_model_path" ] && [ -n "$arg2" ]; then
                if [ -f "$arg2" ]; then
                    _model_path="$arg2"
                else
                    # Try as registry key first (e.g., "minist-inst")
                    _model_path=$(_models_resolve_gguf "$arg2" 2>/dev/null)
                    # Fallback to Ollama model name (e.g., "qwen3:8b")
                    if [ -z "$_model_path" ] || [ ! -f "$_model_path" ]; then
                        _model_path=$(_models_find_ollama_gguf "$arg2" 2>/dev/null)
                    fi
                fi
            fi
            if [ -z "$_model_path" ] || [ ! -f "$_model_path" ]; then
                ui_err "No model file found."
                ui_dim ""
                ui_dim "  Provide a registry key, GGUF path, or Ollama model name:"
                ui_dim "    /backend start minist-inst"
                ui_dim "    /backend start /path/to/model.gguf"
                ui_dim "    /backend start qwen3:8b"
                ui_dim ""
                ui_dim "  Or set LLAMA_CPP_MODEL in your environment:"
                ui_dim "    export LLAMA_CPP_MODEL=~/models/qwen3-8b-q4_k_m.gguf"
                ui_dim ""
                # Show available registry models with GGUF status
                ui_dim "  Registry models (use key names):"
                for _entry in "${_MODELS_REGISTRY[@]}"; do
                    _models_parse_entry "$_entry"
                    local _gguf_avail="✗"
                    _models_resolve_gguf "$_ME_KEY" &>/dev/null && _gguf_avail="✓"
                    ui_dim "    $_ME_KEY  [$_gguf_avail GGUF]"
                done
                return 1
            fi
            ui_info "Starting llama-server..."
            ui_dim "  Binary:  $LLAMA_CPP_SERVER_BIN"
            ui_dim "  Model:   $_model_path"
            ui_dim "  GPU layers: $LLAMA_CPP_GPU_LAYERS"
            ui_dim "  Context: $LLAMA_CPP_CTX_SIZE"
            # Kill Ollama first — frees RAM and avoids confusion
            _llm_kill_ollama --quiet
            # Chat template: --jinja uses the GGUF-embedded Jinja2 template,
            # so no per-model template name resolution is needed.
            if _llm_start_llamacpp_server "$_model_path"; then
                _LLM_BACKEND_CACHE=""
                LLM_BACKEND="llamacpp"
                _llm_save_config
                local _health _status
                _health=$(curl -sf "$LLAMA_CPP_URL/health" 2>/dev/null)
                _status=$(echo "$_health" | jq -r '.status // "unknown"' 2>/dev/null)
                ui_dim "  Health: $_status"
                ui_dim "  Log: ${TMPDIR:-/tmp}/lodge-llama-server.log"
            fi ;;
        stop)
            _llm_stop_llamacpp_server ;;
        model)
            # Show or set the GGUF model path
            if [ -z "$arg2" ]; then
                ui_section "llama-server Model"
                printf "  %-22s %s\n" "Current GGUF:" "${LLAMA_CPP_MODEL:-<not set>}"
                printf "  %-22s %s\n" "GPU layers:" "$LLAMA_CPP_GPU_LAYERS"
                printf "  %-22s %s\n" "Context size:" "$LLAMA_CPP_CTX_SIZE"
                echo ""
                # Show registry models with GGUF availability
                ui_dim "  Registry models:"
                for _entry in "${_MODELS_REGISTRY[@]}"; do
                    _models_parse_entry "$_entry"
                    local _gguf _size _avail="✗"
                    _gguf=$(_models_resolve_gguf "$_ME_KEY" 2>/dev/null)
                    if [ -n "$_gguf" ] && [ -f "$_gguf" ]; then
                        _size=$(du -h "$_gguf" 2>/dev/null | cut -f1)
                        _avail="✓"
                        ui_dim "    $_ME_KEY  [$_avail ${_size:-?}]  $_ME_ROLE"
                    else
                        ui_dim "    $_ME_KEY  [$_avail not pulled]  $_ME_ROLE"
                    fi
                done
            else
                local _path="$arg2"
                # Try registry key first, then Ollama model name, then direct path
                if [[ "$_path" != /* ]] && [[ "$_path" != ~* ]] && [[ "$_path" != *.gguf ]]; then
                    local _resolved
                    _resolved=$(_models_resolve_gguf "$_path" 2>/dev/null)
                    if [ -z "$_resolved" ] || [ ! -f "$_resolved" ]; then
                        _resolved=$(_models_find_ollama_gguf "$_path" 2>/dev/null)
                    fi
                    if [ -n "$_resolved" ] && [ -f "$_resolved" ]; then
                        _path="$_resolved"
                        ui_dim "  Resolved → $_path"
                    fi
                fi
                if [ -f "$_path" ]; then
                    LLAMA_CPP_MODEL="$_path"
                    ui_ok "Model set to: $LLAMA_CPP_MODEL"
                    ui_dim "  Restart llama-server for this to take effect: /backend stop && /backend start"
                else
                    ui_err "File not found: $_path"
                fi
            fi ;;
        reset)
            LLM_BACKEND="llamacpp"
            OLLAMA_URL="http://127.0.0.1:11434"
            LLAMA_CPP_URL="http://127.0.0.1:8080"
            _LLM_BACKEND_CACHE=""
            rm -f "$_LLM_CONFIG_FILE" "$_LLM_BACKEND_PREF_FILE" 2>/dev/null
            ui_ok "Backend reset to defaults (llamacpp preferred)" ;;
        *)
            ui_info "Usage: /backend [status|auto|ollama|llamacpp|start|stop|model|url|reset]"
            echo ""
            ui_dim "  status       — Show active backend and health"
            ui_dim "  auto         — Auto-detect (llamacpp first, fallback ollama)"
            ui_dim "  ollama       — Force Ollama backend"
            ui_dim "  llamacpp     — Force llama-server backend"
