                [ -d "$george_dir/cookies" ]    && printf "    ├── cookies/           (web cookies)\n"
                [ -d "$george_dir/cache" ]      && printf "    └── cache/             (API cache)\n"
            else
                ui_dim "  .george/ does not exist (nothing to clean)"
            fi

            if [ -d "$sandbox_dir" ]; then
                local sandbox_size sandbox_count
                sandbox_size=$(du -sh "$sandbox_dir" 2>/dev/null | awk '{print $1}')
                sandbox_count=$(find "$sandbox_dir" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)
                echo ""
                printf "  %b.sandboxes/%b  %s  (%d sandboxes)\n" "$C_CYAN" "$C_RESET" "$sandbox_size" "$sandbox_count"
            fi

            [ -f "$history_file" ] && {
                echo ""
                printf "  %b.lodge_history%b  (command history)\n" "$C_CYAN" "$C_RESET"
            }

            echo ""
            ui_info "Run /cleanup all to remove everything"
            ui_info "Run /cleanup selective to choose what to remove"
            ;;

        selective)
            ui_section "Selective Cleanup"
            echo ""
            local cleaned=0

            # SSH keys
            if [ -d "$george_dir/.ssh" ]; then
                printf "  Remove SSH keys (.george/.ssh)? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -rf "$george_dir/.ssh"
                    git config --global --unset core.sshCommand 2>/dev/null
                    ui_ok "SSH keys removed"
                    (( cleaned++ ))
                fi
            fi

            # GPG keyring
            if [ -d "$george_dir/.gnupg" ]; then
                printf "  Remove GPG keyring (.george/.gnupg)? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -rf "$george_dir/.gnupg"
                    rm -f "$george_dir/gpg-george.sh"
                    rm -f "$george_dir/george_public.asc"
                    git config --global --unset user.signingkey 2>/dev/null
                    git config --global --unset commit.gpgsign 2>/dev/null
                    git config --global --unset tag.gpgsign 2>/dev/null
                    git config --global --unset gpg.program 2>/dev/null
                    ui_ok "GPG keyring and signing config removed"
                    (( cleaned++ ))
                fi
            fi

            # Email config
            if [ -f "$george_dir/email.conf" ]; then
                printf "  Remove email config (.george/email.conf)? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -f "$george_dir/email.conf"
                    ui_ok "Email config removed"
                    (( cleaned++ ))
                fi
            fi

            # API keys
            if [ -f "$george_dir/keys.conf" ]; then
                printf "  Remove API keys (.george/keys.conf)? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -f "$george_dir/keys.conf"
                    ui_ok "API keys removed"
                    (( cleaned++ ))
                fi
            fi

            # Knowledge base
            if [ -f "$george_dir/recall.db" ]; then
                printf "  Remove knowledge base (.george/recall.db)? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -f "$george_dir/recall.db"
                    rm -f "$george_dir/.recall_mtimes"
                    ui_ok "Knowledge base removed"
                    (( cleaned++ ))
                fi
            fi

            # Secrets vault
            if [ -d "$george_dir/secrets" ]; then
                printf "  Remove secrets vault (.george/secrets)? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -rf "$george_dir/secrets"
                    ui_ok "Secrets vault removed"
                    (( cleaned++ ))
                fi
            fi

            # Sandboxes
            if [ -d "$sandbox_dir" ]; then
                local sc
                sc=$(find "$sandbox_dir" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)
                printf "  Remove all sandboxes (%d sandboxes)? [y/N] " "$sc"
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -rf "$sandbox_dir"
                    ui_ok "Sandboxes removed"
                    (( cleaned++ ))
                fi
            fi

            # Backups
            if [ -d "$george_dir/backups" ]; then
                printf "  Remove identity backups (.george/backups)? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -rf "$george_dir/backups"
                    rm -rf "$george_dir/backup-repo"
                    ui_ok "Backups removed"
                    (( cleaned++ ))
                fi
            fi

            # Cache and cookies
            if [ -d "$george_dir/cache" ] || [ -d "$george_dir/cookies" ]; then
                printf "  Remove cache and cookies? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -rf "$george_dir/cache" "$george_dir/cookies"
                    ui_ok "Cache and cookies removed"
                    (( cleaned++ ))
                fi
            fi

            # History
            if [ -f "$history_file" ]; then
                printf "  Remove command history (.lodge_history)? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -f "$history_file"
                    ui_ok "History removed"
                    (( cleaned++ ))
                fi
            fi

            echo ""
            if [ "$cleaned" -gt 0 ]; then
                ui_ok "Cleaned $cleaned item(s)"
                # Remove empty .george dir if everything was deleted
                if [ -d "$george_dir" ] && [ -z "$(ls -A "$george_dir" 2>/dev/null)" ]; then
                    rmdir "$george_dir" 2>/dev/null
                    ui_ok "Removed empty .george/ directory"
                fi
            else
                ui_info "Nothing removed"
            fi
            ;;

        all)
            ui_section "Full Cleanup"
            echo ""
            ui_warn "This will remove ALL of George's data:"
            echo "  - SSH keys, GPG keyring"
            echo "  - Email config, API keys"
            echo "  - Knowledge base, secrets vault"
            echo "  - Sandboxes, backups, cache"
            echo "  - Command history"
            echo "  - All git signing/SSH configuration"
            echo ""
            printf "  %bAre you sure? Type YES to confirm:%b " "$C_RED" "$C_RESET"
            read -r confirm
            if [ "$confirm" = "YES" ]; then
                # Clean git config entries
                git config --global --unset core.sshCommand 2>/dev/null
                git config --global --unset user.signingkey 2>/dev/null
                git config --global --unset commit.gpgsign 2>/dev/null
                git config --global --unset tag.gpgsign 2>/dev/null
                git config --global --unset gpg.program 2>/dev/null

                rm -rf "$george_dir"
                rm -rf "$sandbox_dir"
                rm -f "$history_file"

                ui_ok "All George data removed"
                ui_dim "Blue Lodge source code is untouched at: $LODGE_DIR"
                ui_dim "To fully uninstall: bash $LODGE_DIR/uninstall.sh"
            else
                ui_warn "Cancelled — nothing removed"
            fi
            ;;

        *)
            ui_err "Usage: /cleanup [status|selective|all]"
            ui_dim "  /cleanup            Show what George has created"
            ui_dim "  /cleanup selective  Choose what to remove"
            ui_dim "  /cleanup all        Remove everything (requires YES confirmation)"
            ;;
    esac
}
