_cmd_backup() {
    local args="$1"
    local action
    action=$(echo "$args" | awk '{print $1}')
    local rest
    rest=$(echo "$args" | sed 's/^[^ ]* *//')

    case "$action" in
        local)    backup_local ;;
        restore)  backup_restore "$rest" ;;
        list|ls)  backup_list ;;
        status)   backup_status ;;
        prune)    backup_prune "$rest" ;;
        git)
            local sub
            sub=$(echo "$rest" | awk '{print $1}')
            local gargs
            gargs=$(echo "$rest" | sed 's/^[^ ]* *//')
            case "$sub" in
                init)  backup_git_init ;;
                save)  backup_git_save "$gargs" ;;
                push)  backup_git_push ;;
                pull)  backup_git_pull ;;
                clone) backup_git_clone "$gargs" ;;
