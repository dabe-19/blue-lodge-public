                x|twitter)
                    if [ -z "$after_platform" ] || [ "$after_platform" = "$platform" ]; then
                        ui_info "Usage: /social post x <message>"
                        return 1
                    fi
                    social_post "$after_platform" "x" ;;
                mastodon|masto)
                    # Optional instance param: /social post mastodon [instance:name] <text>
                    local _inst="" _mtext="$after_platform"
                    if [[ "$after_platform" =~ ^instance: ]]; then
                        _inst=$(echo "$after_platform" | awk '{print $1}' | sed 's/^instance://')
                        _mtext=$(echo "$after_platform" | sed 's/^[^ ]* *//')
                    fi
                    if [ -z "$_mtext" ] || [ "$_mtext" = "$platform" ]; then
                        ui_info "Usage: /social post mastodon [instance:<name>] <message>"
                        return 1
                    fi
                    mastodon_post "$_mtext" "$_inst" ;;
                bluesky|bsky)
                    if [ -z "$after_platform" ] || [ "$after_platform" = "$platform" ]; then
                        ui_info "Usage: /social post bluesky <message>"
                        return 1
                    fi
                    social_post "$after_platform" "bluesky" ;;
