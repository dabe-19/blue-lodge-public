                        local tmpfile; tmpfile=$(mktemp)
                        grep -v "^${kname}=" "$GEORGE_KEYS_FILE" > "$tmpfile"
                        mv "$tmpfile" "$GEORGE_KEYS_FILE"
                        ui_ok "Key $kname removed"
                    fi ;;
                *) ui_info "Usage: /api keys <list|set|rm>" ;;
            esac ;;
        status)
