# ── Graceful Cancellation ─────────────────────────────────────
# Tracks whether we're in task execution so Ctrl+C behaves smartly:
# - During LLM generation → kill the request, unload model, return to prompt
# - During REPL idle → exit cleanly
_LODGE_IN_TASK=0
_LODGE_CANCELLED=0

_lodge_cleanup() {
    # Stop spinner if running
    ui_spinner_stop 2>/dev/null

    # Cancel active LLM request
    llm_cancel 2>/dev/null

    if [ "$_LODGE_IN_TASK" -eq 1 ]; then
        _LODGE_CANCELLED=1
        echo ""
        ui_warn "Cancelled by user"

        # Unload model to free RAM — safe because persistence
        # lives in CLAUDE.md and journal.md, not in model state
        llm_unload 2>/dev/null

        # Don't exit — return to REPL
        return 0
    else
        # Not in a task: clean exit
        echo ""
        ui_info "Interrupted. Unloading model..."
        llm_unload 2>/dev/null
        if command -v termux-wake-unlock &>/dev/null; then
            termux-wake-unlock 2>/dev/null
        fi
        exit 0
    fi
}

trap '_lodge_cleanup' INT

