_cmd_journal() {
    local args="$1"
    local action
    action=$(echo "$args" | awk '{print $1}')
    local rest
    rest=$(echo "$args" | sed 's/^[^ ]* *//')
    
    case "$action" in
        show|"")
            journal_show "${rest:-all}" ;;
        vivid)
            journal_show vivid ;;
        fading)
            journal_show fading ;;
        sediment)
            journal_show sediment ;;
        write)
            if [ -z "$rest" ]; then
                printf " %bWrite a journal entry:%b " "$C_WHITE" "$C_RESET"
                read -r rest
            fi
            journal_write "reflection" "$rest"
            ui_ok "Entry recorded" ;;
        decay)
            journal_apply_decay ;;
        count)
            local c
            c=$(journal_count)
            ui_info "$c entries in journal" ;;
        *)
            ui_info "Usage: /journal <show|vivid|fading|sediment|write|decay|count>" ;;
    esac
}
_cmd_reflect() {
    local context="$1"
    if [ -z "$context" ]; then
        context="General session work in $(basename "$PWD")"
    fi
    ui_spinner_start "Reflecting"
    journal_reflect "$context" "$PWD"
    ui_spinner_stop
    ui_ok "Reflection recorded"
}
_cmd_status() {
    ui_section "Status"
    printf "  %bModel:%b     %s\n" "$C_CYAN" "$C_RESET" "$LODGE_MODEL"
    printf "  %bProject:%b   %s\n" "$C_CYAN" "$C_RESET" "$LODGE_PROJECT"
    printf "  %bWorkdir:%b   %s\n" "$C_CYAN" "$C_RESET" "$PWD"
    printf "  %bPermission:%b %s\n" "$C_CYAN" "$C_RESET" "$([ "$LODGE_PERMISSION" -eq 0 ] && echo 'ask-all' || ([ "$LODGE_PERMISSION" -eq 1 ] && echo 'ask-destructive' || echo 'auto'))"
    local mem_exists="no"
    [ -f "./CLAUDE.md" ] && mem_exists="yes"
    printf "  %bCLAUDE.md:%b %s\n" "$C_CYAN" "$C_RESET" "$mem_exists"
    local j_count
    j_count=$(journal_count)
    printf "  %bJournal:%b   %s entries\n" "$C_CYAN" "$C_RESET" "$j_count"
    
    # Battery if available
    local batt
    batt=$(tools_phone_battery 2>/dev/null)
    if [ -n "$batt" ] && [ "$batt" != '{"percentage": "unknown"}' ]; then
        local pct
        pct=$(echo "$batt" | jq -r '.percentage' 2>/dev/null)
        printf "  %bBattery:%b   %s%%\n" "$C_CYAN" "$C_RESET" "$pct"
    fi
    echo ""
}
# ── Sandbox fuzzy heuristics ──────────────────────────────────
# George sometimes hallucinates subcommand names or swaps arg order.
# These resolvers silently correct common mistakes.

# Fuzzy-resolve a sandbox action/subcommand to a canonical one.
# Sets _SANDBOX_ACTION to the canonical action, returns 0 on match.
_sandbox_fuzzy_action() {
    local raw="${1,,}"  # lowercase
    _SANDBOX_ACTION=""
    case "$raw" in
        # Exact matches + known aliases
        list|ls|show|all)         _SANDBOX_ACTION="list"    ;;
        new|create|make|add|init) _SANDBOX_ACTION="new"     ;;
        build|compile|make)       _SANDBOX_ACTION="build"   ;;
        test|check|verify)        _SANDBOX_ACTION="test"    ;;
        rm|remove|delete|del|destroy) _SANDBOX_ACTION="rm"  ;;
        clone|git-clone)          _SANDBOX_ACTION="clone"   ;;
        cd|enter|switch|goto|open) _SANDBOX_ACTION="cd"     ;;
        status|info|detail|details) _SANDBOX_ACTION="status" ;;
        journal|log|history|events) _SANDBOX_ACTION="journal" ;;
        run|exec|execute|do|cmd)  _SANDBOX_ACTION="run"     ;;
        *)                        return 1 ;;
    esac
    return 0
}

# Fuzzy-resolve a project type for sandboxes.
# Sandbox types are: rust, python, shell (simpler than /init types).
# Sets _SANDBOX_TYPE to the canonical type, returns 0 on match.
_sandbox_fuzzy_type() {
    local raw="${1,,}"
    _SANDBOX_TYPE=""
    case "$raw" in
        rust|rs|cargo|crate|rusty|rustlang) _SANDBOX_TYPE="rust"   ;;
        python|py|python3|pip|uv|pyth)      _SANDBOX_TYPE="python" ;;
        shell|sh|bash|zsh|cli|script)       _SANDBOX_TYPE="shell"  ;;
        *)  # Substring fallback
            if [[ "$raw" == rust* ]] || [[ "$raw" == *cargo* ]]; then
                _SANDBOX_TYPE="rust"
            elif [[ "$raw" == py* ]] || [[ "$raw" == *python* ]]; then
                _SANDBOX_TYPE="python"
            elif [[ "$raw" == *bash* ]] || [[ "$raw" == *shell* ]] || [[ "$raw" == *cli* ]]; then
                _SANDBOX_TYPE="shell"
            else
                return 1
            fi ;;
    esac
    return 0
}

# Check if a string matches an existing sandbox name.
_sandbox_name_exists() {
    [ -d "$LODGE_SANDBOXES/${1}" ]
}

_cmd_sandbox() {
    local args="$1"
    local action
    action=$(echo "$args" | awk '{print $1}')
    local rest
    rest=$(echo "$args" | sed 's/^[^ ]* *//')

    # ── Fuzzy-resolve the action ──────────────────────────────
    if ! _sandbox_fuzzy_action "$action"; then
        # If the first word is actually a sandbox name (e.g. "/sandbox myapp build"),
        # try swapping: treat word1 as name and word2 as action.
        local maybe_name="$action"
        local maybe_action
        maybe_action=$(echo "$rest" | awk '{print $1}')
        if _sandbox_name_exists "$maybe_name" && _sandbox_fuzzy_action "$maybe_action"; then
            action="$_SANDBOX_ACTION"
            rest="$maybe_name $(echo "$rest" | sed 's/^[^ ]* *//')"
            ui_dim "Reinterpreted: /sandbox $action $rest"
        else
            ui_info "Usage: /sandbox <list|new|build|test|run|status|journal|rm|clone|cd> [args]"
            sandbox_list
            return
        fi
    else
        action="$_SANDBOX_ACTION"
    fi

    case "$action" in
        list)   sandbox_list ;;
        new)
            local name type
            name=$(echo "$rest" | awk '{print $1}')
            type=$(echo "$rest" | awk '{print $2}')

            # ── Arg-swap detection: "/sandbox new rust myapp" ──
            if _sandbox_fuzzy_type "$name" && ! _sandbox_fuzzy_type "${type:-}"; then
                # First arg looks like a type, second doesn't — swap them
                local swap_type="$_SANDBOX_TYPE"
                local swap_name="$type"
                if [ -n "$swap_name" ]; then
                    ui_dim "Reinterpreted: /sandbox new $swap_name $swap_type"
                    name="$swap_name"
                    type="$swap_type"
                fi
            fi

            # ── Fuzzy-resolve the type ────────────────────────
            if [ -n "$type" ]; then
                if _sandbox_fuzzy_type "$type"; then
                    type="$_SANDBOX_TYPE"
                else
                    ui_warn "Unknown type '$type' — defaulting to shell"
                    type="shell"
                fi
            else
                type="shell"
            fi

            sandbox_create "$name" "$type" ;;
        build)     sandbox_build "$rest" ;;
        test)      sandbox_test "$rest" ;;
        rm)        sandbox_remove "$rest" ;;
        clone)
            local url name
            url=$(echo "$rest" | awk '{print $1}')
            name=$(echo "$rest" | awk '{print $2}')
            sandbox_clone "$url" "$name" ;;
        cd)
            local name="$rest"
            local dir="$LODGE_SANDBOXES/$name"
            if [ -d "$dir" ]; then
                cd "$dir"
                export LODGE_PROJECT="$name"
                ui_ok "Switched to sandbox: $name"
            else
                ui_err "Sandbox '$name' not found"
            fi ;;
        status)    sandbox_status "$rest" ;;
        journal)
            local n="${rest:-20}"
            sandbox_journal_read "$n" ;;
        run)
            local name cmd
            name=$(echo "$rest" | awk '{print $1}')
            cmd=$(echo "$rest" | sed 's/^[^ ]* *//')
            sandbox_exec "$name" "$cmd" ;;
    esac
}
_cmd_phone() {
    local args="$1"
    local action
    action=$(echo "$args" | awk '{print $1}')
    local rest
    rest=$(echo "$args" | sed 's/^[^ ]* *//')
    
    case "$action" in
        # ── Location ────────────────────────────────
        location|loc|gps)
            ui_section "Location"
            local provider="network"
            [[ "$rest" == "gps" ]] && provider="gps"
            phone_location_summary "$provider" 30
            ;;
        where)
            # Compact one-liner for LLM context
            phone_location_context
            ;;
        # ── SMS / Text Messages ─────────────────────
        sms|texts|messages)
            local sub
            sub=$(echo "$rest" | awk '{print $1}')
            local sms_rest
            sms_rest=$(echo "$rest" | sed 's/^[^ ]* *//')
            case "$sub" in
                inbox|"")
                    ui_section "SMS Inbox"
                    phone_sms_pretty "inbox" "${sms_rest:-10}" ;;
                sent)
                    ui_section "SMS Sent"
                    phone_sms_pretty "sent" "${sms_rest:-10}" ;;
                send)
                    local sms_num
                    sms_num=$(echo "$sms_rest" | awk '{print $1}')
                    local sms_body
                    sms_body=$(echo "$sms_rest" | sed 's/^[^ ]* *//')
                    phone_sms_send "$sms_num" "$sms_body" ;;
                all)
                    ui_section "All SMS"
                    phone_sms_pretty "all" "${sms_rest:-10}" ;;
                *)
                    ui_section "SMS Inbox"
                    phone_sms_pretty "inbox" 10 ;;
            esac ;;
        # ── Telephony ───────────────────────────────
        telephony|tel|carrier)
            ui_section "Telephony"
            phone_call_state ;;
        calls|calllog|call-log)
            ui_section "Call Log"
            phone_call_log_pretty "${rest:-10}" ;;
        cell|signal)
            ui_section "Cell Info"
            phone_cell_info ;;
        # ── WiFi ────────────────────────────────────
        wifi)
            ui_section "WiFi"
            local wifi_sub
            wifi_sub=$(echo "$rest" | awk '{print $1}')
            case "$wifi_sub" in
                scan)   phone_wifi_scan ;;
                *)      phone_wifi_info ;;
            esac ;;
        # ── Status / Dashboard ──────────────────────
        status|dashboard|"")
            phone_dashboard ;;
        # ── Original tools (preserved) ──────────────
        battery)  tools_phone_battery ;;
        clip|clipboard)
            if [ -n "$rest" ] && [ "$rest" != "$args" ]; then
                tools_phone_clipboard_set "$rest"
            else
                tools_phone_clipboard_get
            fi ;;
        notify)   tools_phone_notify "George" "$rest" ;;
        open)     tools_phone_open_url "$rest" ;;
        share)    tools_phone_share "$rest" ;;
        toast)    tools_phone_toast "$rest" ;;
        vibrate)  tools_phone_vibrate ;;
        permissions|perms|setup)
            phone_fix_permissions ;;
        *)
            ui_section "Phone Commands"
            ui_dim "  /phone                — Full phone dashboard (battery, carrier, WiFi, location)"
            ui_dim "  /phone permissions    — Permission setup guide + connectivity test"
            ui_dim "  /phone location [gps] — Current location (network or GPS)"
            ui_dim "  /phone where           — One-line location for context"
            ui_dim "  /phone sms [inbox|sent|all] [limit] — Read text messages"
            ui_dim "  /phone sms send <number> <message>  — Send a text message"
            ui_dim "  /phone calls [limit]  — Recent call log"
            ui_dim "  /phone telephony      — Carrier, SIM, data state"
            ui_dim "  /phone cell           — Cell tower / signal info"
            ui_dim "  /phone wifi           — WiFi connection info"
            ui_dim "  /phone wifi scan      — Scan nearby WiFi networks"
            ui_dim "  /phone battery        — Battery status"
            ui_dim "  /phone clip [text]    — Clipboard get/set"
            ui_dim "  /phone notify <msg>   — Send notification"
            ui_dim "  /phone open <url>     — Open URL"
            ui_dim "  /phone share <file>   — Share a file"
            ui_dim "  /phone toast <msg>    — Show toast message"
            ui_dim "  /phone vibrate        — Vibrate"
            echo "" ;;
    esac
}
_cmd_clear() {
    clear
}
_cmd_cleanup() {
    local args="$1"
    local george_dir="${GEORGE_CONFIG_DIR:-$LODGE_DIR/.george}"
    local sandbox_dir="${LODGE_SANDBOXES:-$LODGE_DIR/.sandboxes}"
    local history_file="${LODGE_HISTORY_FILE:-$LODGE_DIR/.lodge_history}"

    case "${args%% *}" in
        status|"")
            ui_section "George File Inventory"
            echo ""
            if [ -d "$george_dir" ]; then
                local total_size
                total_size=$(du -sh "$george_dir" 2>/dev/null | awk '{print $1}')
                printf "  %b.george/%b  %s\n" "$C_CYAN" "$C_RESET" "$total_size"
                # Itemize major contents
                [ -f "$george_dir/email.conf" ] && printf "    ├── email.conf         (email credentials)\n"
                [ -d "$george_dir/.ssh" ]       && printf "    ├── .ssh/              (SSH keys)\n"
                [ -d "$george_dir/.gnupg" ]     && printf "    ├── .gnupg/            (GPG keyring)\n"
                [ -f "$george_dir/recall.db" ]  && printf "    ├── recall.db          (knowledge base)\n"
                [ -f "$george_dir/keys.conf" ]  && printf "    ├── keys.conf          (API keys)\n"
                [ -d "$george_dir/secrets" ]    && printf "    ├── secrets/           (encrypted vault)\n"
                [ -d "$george_dir/backups" ]    && printf "    ├── backups/           (identity backups)\n"
                [ -f "$george_dir/sandbox_journal.jsonl" ] && printf "    ├── sandbox_journal    (sandbox history)\n"
                [ -f "$george_dir/gpg-george.sh" ] && printf "    ├── gpg-george.sh      (GPG wrapper)\n"
                [ -f "$george_dir/george_public.asc" ] && printf "    ├── george_public.asc  (GPG public key)\n"
                [ -d "$george_dir/slash" ]      && printf "    ├── slash/             (custom commands)\n"
                [ -d "$george_dir/cookies" ]    && printf "    ├── cookies/           (web cookies)\n"
                [ -d "$george_dir/cache" ]      && printf "    └── cache/             (API cache)\n"
            else
                ui_dim "  .george/ does not exist (nothing to clean)"
            fi

            if [ -d "$sandbox_dir" ]; then
                local sandbox_size sandbox_count
                sandbox_size=$(du -sh "$sandbox_dir" 2>/dev/null | awk '{print $1}')
                sandbox_count=$(find "$sandbox_dir" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)
                echo ""
                printf "  %b.sandboxes/%b  %s  (%d sandboxes)\n" "$C_CYAN" "$C_RESET" "$sandbox_size" "$sandbox_count"
            fi

            [ -f "$history_file" ] && {
                echo ""
                printf "  %b.lodge_history%b  (command history)\n" "$C_CYAN" "$C_RESET"
            }

            echo ""
            ui_info "Run /cleanup all to remove everything"
            ui_info "Run /cleanup selective to choose what to remove"
            ;;

        selective)
            ui_section "Selective Cleanup"
            echo ""
            local cleaned=0

            # SSH keys
            if [ -d "$george_dir/.ssh" ]; then
                printf "  Remove SSH keys (.george/.ssh)? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -rf "$george_dir/.ssh"
                    git config --global --unset core.sshCommand 2>/dev/null
                    ui_ok "SSH keys removed"
                    (( cleaned++ ))
                fi
            fi

            # GPG keyring
            if [ -d "$george_dir/.gnupg" ]; then
                printf "  Remove GPG keyring (.george/.gnupg)? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -rf "$george_dir/.gnupg"
                    rm -f "$george_dir/gpg-george.sh"
                    rm -f "$george_dir/george_public.asc"
                    git config --global --unset user.signingkey 2>/dev/null
                    git config --global --unset commit.gpgsign 2>/dev/null
                    git config --global --unset tag.gpgsign 2>/dev/null
                    git config --global --unset gpg.program 2>/dev/null
                    ui_ok "GPG keyring and signing config removed"
                    (( cleaned++ ))
                fi
            fi

            # Email config
            if [ -f "$george_dir/email.conf" ]; then
                printf "  Remove email config (.george/email.conf)? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -f "$george_dir/email.conf"
                    ui_ok "Email config removed"
                    (( cleaned++ ))
                fi
            fi

            # API keys
            if [ -f "$george_dir/keys.conf" ]; then
                printf "  Remove API keys (.george/keys.conf)? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -f "$george_dir/keys.conf"
                    ui_ok "API keys removed"
                    (( cleaned++ ))
                fi
            fi

            # Knowledge base
            if [ -f "$george_dir/recall.db" ]; then
                printf "  Remove knowledge base (.george/recall.db)? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -f "$george_dir/recall.db"
                    rm -f "$george_dir/.recall_mtimes"
                    ui_ok "Knowledge base removed"
                    (( cleaned++ ))
                fi
            fi

            # Secrets vault
            if [ -d "$george_dir/secrets" ]; then
                printf "  Remove secrets vault (.george/secrets)? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -rf "$george_dir/secrets"
                    ui_ok "Secrets vault removed"
                    (( cleaned++ ))
                fi
            fi

            # Sandboxes
            if [ -d "$sandbox_dir" ]; then
                local sc
                sc=$(find "$sandbox_dir" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)
                printf "  Remove all sandboxes (%d sandboxes)? [y/N] " "$sc"
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -rf "$sandbox_dir"
                    ui_ok "Sandboxes removed"
                    (( cleaned++ ))
                fi
            fi

            # Backups
            if [ -d "$george_dir/backups" ]; then
                printf "  Remove identity backups (.george/backups)? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -rf "$george_dir/backups"
                    rm -rf "$george_dir/backup-repo"
                    ui_ok "Backups removed"
                    (( cleaned++ ))
                fi
            fi

            # Cache and cookies
            if [ -d "$george_dir/cache" ] || [ -d "$george_dir/cookies" ]; then
                printf "  Remove cache and cookies? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -rf "$george_dir/cache" "$george_dir/cookies"
                    ui_ok "Cache and cookies removed"
                    (( cleaned++ ))
                fi
            fi

            # History
            if [ -f "$history_file" ]; then
                printf "  Remove command history (.lodge_history)? [y/N] "
                read -r ans
                if [[ "${ans,,}" == "y"* ]]; then
                    rm -f "$history_file"
                    ui_ok "History removed"
                    (( cleaned++ ))
                fi
            fi

            echo ""
            if [ "$cleaned" -gt 0 ]; then
                ui_ok "Cleaned $cleaned item(s)"
                # Remove empty .george dir if everything was deleted
                if [ -d "$george_dir" ] && [ -z "$(ls -A "$george_dir" 2>/dev/null)" ]; then
                    rmdir "$george_dir" 2>/dev/null
                    ui_ok "Removed empty .george/ directory"
                fi
            else
                ui_info "Nothing removed"
            fi
            ;;

        all)
            ui_section "Full Cleanup"
            echo ""
            ui_warn "This will remove ALL of George's data:"
            echo "  - SSH keys, GPG keyring"
            echo "  - Email config, API keys"
            echo "  - Knowledge base, secrets vault"
            echo "  - Sandboxes, backups, cache"
            echo "  - Command history"
            echo "  - All git signing/SSH configuration"
            echo ""
            printf "  %bAre you sure? Type YES to confirm:%b " "$C_RED" "$C_RESET"
            read -r confirm
            if [ "$confirm" = "YES" ]; then
                # Clean git config entries
                git config --global --unset core.sshCommand 2>/dev/null
                git config --global --unset user.signingkey 2>/dev/null
                git config --global --unset commit.gpgsign 2>/dev/null
                git config --global --unset tag.gpgsign 2>/dev/null
                git config --global --unset gpg.program 2>/dev/null

                rm -rf "$george_dir"
                rm -rf "$sandbox_dir"
                rm -f "$history_file"

                ui_ok "All George data removed"
                ui_dim "Blue Lodge source code is untouched at: $LODGE_DIR"
                ui_dim "To fully uninstall: bash $LODGE_DIR/uninstall.sh"
            else
                ui_warn "Cancelled — nothing removed"
            fi
            ;;

        *)
            ui_err "Usage: /cleanup [status|selective|all]"
            ui_dim "  /cleanup            Show what George has created"
            ui_dim "  /cleanup selective  Choose what to remove"
            ui_dim "  /cleanup all        Remove everything (requires YES confirmation)"
            ;;
    esac
}
