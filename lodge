                ui_section "Free-Tier Model Rate Limits"
                echo ""
                local _lm_p
                for _lm_p in google groq openai anthropic mistral together perplexity cohere deepseek xai; do
                    local _lm_count
                    _lm_count=$(jq -r --arg p "$_lm_p" '.[$p].models // {} | keys | length' "$_limits_file" 2>/dev/null)
                    if [ "${_lm_count:-0}" -gt 0 ]; then
                        printf "  %b%-15s%b %s models configured\n" "$C_CYAN" "$_lm_p" "$C_RESET" "$_lm_count"
                    else
                        printf "  %b%-15s%b %b(no limits configured)%b\n" "$C_DIM" "$_lm_p" "$C_RESET" "$C_DIM" "$C_RESET"
                    fi
                done
                echo ""
                ui_dim "  Usage: /limits models <provider>   — show model rate limits"
                ui_dim "         /limits suggest <provider>   — show suggested /limit settings"
                ui_dim "         /limits apply <provider>     — apply suggested settings"
                ui_dim "         /limits fetch <provider>     — list models from API"
            else
                local _lm_canon
                _lm_canon=$(_provider_canon "$_lm_provider")
                local _lm_lower
                _lm_lower=$(echo "${_lm_canon:-$_lm_provider}" | tr '[:upper:]' '[:lower:]')
                local _lm_count
                _lm_count=$(jq -r --arg p "$_lm_lower" '.[$p].models // {} | keys | length' "$_limits_file" 2>/dev/null)

                if [ "${_lm_count:-0}" -eq 0 ]; then
                    ui_info "No rate limits configured for $_lm_lower"
                    ui_dim "Add entries to models/free-tier-limits.json or run: /limits fetch $_lm_lower"
                    return 0
                fi

                ui_section "Free-Tier Rate Limits: $_lm_lower"
                echo ""
                printf "  %b%-40s %6s %8s %8s %8s%b\n" "$C_DIM" "MODEL" "RPM" "RPD" "TPM" "TPD" "$C_RESET"
                printf "  %b%-40s %6s %8s %8s %8s%b\n" "$C_DIM" "$(printf '%0.s─' {1..40})" "──────" "────────" "────────" "────────" "$C_RESET"

                local _lm_json
                _lm_json=$(jq -r --arg p "$_lm_lower" \
                    '.[$p].models | to_entries[] | "\(.key)\t\(.value.rpm // "-")\t\(.value.rpd // "-")\t\(.value.tpm // "-")\t\(.value.tpd // "-")"' \
                    "$_limits_file" 2>/dev/null | sort)

                local _lm_active_model=""
                _lm_active_model=$(api_get_key "PROVIDER_MODEL_${_lm_canon}" 2>/dev/null)

                while IFS=$'\t' read -r _m _rpm _rpd _tpm _tpd; do
                    [ -z "$_m" ] && continue
                    local _marker="  "
                    if [ "$_m" = "$_lm_active_model" ]; then
                        _marker=$(printf "%b▸%b " "$C_GREEN" "$C_RESET")
                    fi
                    printf "  %s%-38s %6s %8s %8s %8s\n" "$_marker" "$_m" "$_rpm" "$_rpd" "$_tpm" "$_tpd"
                done <<< "$_lm_json"
                echo ""
                if [ -n "$_lm_active_model" ]; then
                    ui_dim "  ▸ = active model"
                fi
            fi ;;
        suggest)
            # /limits suggest [provider] — show suggested settings
            local _ls_provider
            _ls_provider=$(echo "$args" | awk '{print $2}')
            if [ -z "$_ls_provider" ]; then
                ui_info "Usage: /limits suggest <provider>"
                ui_dim "  Shows the recommended /limit settings for a provider's free tier."
                ui_dim "  Providers: google, groq, openai, anthropic, mistral, together, perplexity, cohere, deepseek, xai"
                return 0
            fi

            local _ls_canon
            _ls_canon=$(_provider_canon "$_ls_provider")
            local _ls_lower
            _ls_lower=$(echo "${_ls_canon:-$_ls_provider}" | tr '[:upper:]' '[:lower:]')

            local _ls_suggested
            _ls_suggested=$(provider_suggested_limits "$_ls_lower" 2>/dev/null)
            if [ -z "$_ls_suggested" ]; then
                ui_info "No suggested limits for $_ls_lower"
                return 0
            fi

            ui_section "Suggested /limit Settings: $_ls_lower"
            echo ""
            printf "  %bThese settings keep George safely within the free-tier rate limits:%b\n\n" "$C_DIM" "$C_RESET"

            while IFS= read -r _ls_line; do
                [ -z "$_ls_line" ] && continue
                local _ls_key _ls_val
                _ls_key=$(echo "$_ls_line" | awk '{print $1}')
                _ls_val=$(echo "$_ls_line" | awk '{print $2}')
                local _ls_current
                case "$_ls_key" in
                    api-delay)           _ls_current="$PROVIDER_CALL_DELAY" ;;
                    api-retries)         _ls_current="$PROVIDER_MAX_RETRIES" ;;
                    api-backoff)         _ls_current="$PROVIDER_INITIAL_BACKOFF" ;;
                    api-max-backoff)     _ls_current="$PROVIDER_MAX_BACKOFF" ;;
                    api-cooldown-max)    _ls_current="$PROVIDER_COOLDOWN_MAX" ;;
                    api-cooldown-window) _ls_current="$PROVIDER_COOLDOWN_WINDOW" ;;
                    *)                   _ls_current="?" ;;
                esac
                local _ls_match=""
                [ "$_ls_current" = "$_ls_val" ] && _ls_match=$(printf " %b(current)%b" "$C_GREEN" "$C_RESET")
                printf "  /limits %-22s %s%s\n" "$_ls_key $_ls_val" "" "$_ls_match"
            done <<< "$_ls_suggested"

            echo ""
            ui_dim "  Apply all at once: /limits apply $_ls_lower" ;;
        apply)
            # /limits apply <provider> — apply suggested settings
            local _la_provider
            _la_provider=$(echo "$args" | awk '{print $2}')
            if [ -z "$_la_provider" ]; then
                ui_info "Usage: /limits apply <provider>"
                ui_dim "  Applies the recommended rate limit settings for a provider's free tier."
                return 0
            fi

            local _la_canon
            _la_canon=$(_provider_canon "$_la_provider")
            local _la_lower
            _la_lower=$(echo "${_la_canon:-$_la_provider}" | tr '[:upper:]' '[:lower:]')

            local _la_before_delay="$PROVIDER_CALL_DELAY"
            local _la_before_retries="$PROVIDER_MAX_RETRIES"
            local _la_before_backoff="$PROVIDER_INITIAL_BACKOFF"
            local _la_before_maxbo="$PROVIDER_MAX_BACKOFF"
            local _la_before_cdmax="$PROVIDER_COOLDOWN_MAX"
            local _la_before_cdwin="$PROVIDER_COOLDOWN_WINDOW"

            provider_apply_suggested_limits "$_la_lower"

            ui_ok "Applied suggested limits for $_la_lower"
            printf "  %-22s %s → %s\n" "api-delay:" "$_la_before_delay" "$PROVIDER_CALL_DELAY"
            printf "  %-22s %s → %s\n" "api-retries:" "$_la_before_retries" "$PROVIDER_MAX_RETRIES"
            printf "  %-22s %s → %s\n" "api-backoff:" "$_la_before_backoff" "$PROVIDER_INITIAL_BACKOFF"
            printf "  %-22s %s → %s\n" "api-max-backoff:" "$_la_before_maxbo" "$PROVIDER_MAX_BACKOFF"
            printf "  %-22s %s → %s\n" "api-cooldown-max:" "$_la_before_cdmax" "$PROVIDER_COOLDOWN_MAX"
            printf "  %-22s %s → %s\n" "api-cooldown-window:" "$_la_before_cdwin" "$PROVIDER_COOLDOWN_WINDOW" ;;
        fetch)
            # /limits fetch <provider> — list models from live API
            local _lf_provider
            _lf_provider=$(echo "$args" | awk '{print $2}')
            if [ -z "$_lf_provider" ]; then
                ui_info "Usage: /limits fetch <provider>"
                ui_dim "  Fetches the list of available models from the provider's API."
                ui_dim "  Requires the provider's API key to be configured."
                return 0
            fi

            ui_think "Fetching models from $_lf_provider API..."
            local _lf_models
            _lf_models=$(provider_models "$_lf_provider" 2>&1)
            local _lf_rc=$?

            if [ $_lf_rc -ne 0 ] || [ -z "$_lf_models" ]; then
                ui_err "Failed to fetch models from $_lf_provider"
                [ -n "$_lf_models" ] && ui_dim "  $_lf_models"
                return 1
            fi

            local _lf_canon
            _lf_canon=$(_provider_canon "$_lf_provider")
            local _lf_lower
            _lf_lower=$(echo "${_lf_canon:-$_lf_provider}" | tr '[:upper:]' '[:lower:]')

            local _lf_count
            _lf_count=$(echo "$_lf_models" | wc -l)
            ui_section "Available Models: $_lf_lower ($_lf_count)"
            echo ""

            # Cross-reference with rate limits config
            local _limits_file="${LODGE_DIR}/models/free-tier-limits.json"
            local _lf_model
            while IFS= read -r _lf_model; do
                [ -z "$_lf_model" ] && continue
                local _lf_has_limits=""
                if [ -f "$_limits_file" ]; then
                    local _lf_check
                    _lf_check=$(jq -r --arg p "$_lf_lower" --arg m "$_lf_model" \
                        '.[$p].models[$m] // empty' "$_limits_file" 2>/dev/null)
                    [ -n "$_lf_check" ] && _lf_has_limits=$(printf " %b(limits configured)%b" "$C_GREEN" "$C_RESET")
                fi
                printf "  %-45s%s\n" "$_lf_model" "$_lf_has_limits"
            done <<< "$_lf_models"
            echo ""
            if [ -f "$_limits_file" ]; then
                local _lf_configured
                _lf_configured=$(jq -r --arg p "$_lf_lower" '.[$p].models // {} | keys | length' "$_limits_file" 2>/dev/null)
                ui_dim "  ${_lf_configured:-0} of $_lf_count models have rate limits configured in free-tier-limits.json"
            fi ;;
        "")
            ui_section "Agent Limits"
            printf "  %-22s %s\n" "Plan steps/subtask:" "$AGENT_PLAN_STEPS  (default: 6)"
            local _expand_show="disabled"
            [ "${AGENT_HONEYDEW_EXPAND:-0}" -eq 1 ] && _expand_show="enabled"
            printf "  %-22s %s\n" "Honeydew expansion:" "$_expand_show  (default: disabled)"
            local _rewrite_show="disabled"
            [ "${AGENT_HONEYDEW_REWRITE:-0}" -eq 1 ] && _rewrite_show="enabled"
            printf "  %-22s %s\n" "Honeydew rewrite:" "$_rewrite_show  (default: enabled)"
            printf "  %-22s %s\n" "Rewrite rounds:" "${AGENT_HONEYDEW_REWRITE_ROUNDS:-3}  (default: 3)"
            printf "  %-22s %s\n" "Rewrite cadence:" "${AGENT_HONEYDEW_REWRITE_CADENCE:-2}  (default: 2)"
            printf "  %-22s %s\n" "Subtask depth:" "$AGENT_MAX_DEPTH  (default: 3)"
            printf "  %-22s %s\n" "Honeydew max items:" "$AGENT_HONEYDEW_MAX_ITEMS  (default: 16)"
            printf "  %-22s %s\n" "Macro milestones:" "$AGENT_MAX_STEPS  (default: 40)"
            printf "  %-22s %s\n" "Inner loop retries:" "$AGENT_INNER_LOOPS  (default: 6)"
            printf "  %-22s %s\n" "Step delay:" "${AGENT_STEP_DELAY}s  (default: 1)"
            printf "  %-22s %s\n" "Eval mode:" "$AGENT_EVAL_MODE  (default: auto, options: auto|interactive|disabled)"
            printf "  %-22s %s\n" "Eval context lines:" "${AGENT_EVAL_CONTEXT_LINES:-50}  (default: 50)"
            printf "  %-22s %s\n" "Web sufficiency:" "$AGENT_WEB_SUFFICIENCY  (default: 20)"
            printf "  %-22s %s\n" "Milestone retries:" "$AGENT_MAX_MILESTONE_RETRIES  (default: 20)"
            printf "  %-22s %s\n" "Command family cap:" "$AGENT_MAX_CMD_FAMILY  (default: 10)"
            printf "  %-22s %s\n" "Honeydew match score:" "$AGENT_HONEYDEW_MATCH  (default: 3)"
            printf "  %-22s %s\n" "Web search repeat:" "${AGENT_WEB_SEARCH_CONSEC_MAX:-20}  (default: 20)"
            printf "  %-22s %s\n" "Recommendation chars:" "${AGENT_EVAL_REC_CHARS:-120}  (default: 120)"
            local _tp_show="disabled"
            [ "${AGENT_WEB_SEARCH_TIGHT_PARSING:-0}" -eq 1 ] && _tp_show="enabled"
            printf "  %-22s %s\n" "Tight parsing:" "$_tp_show  (default: disabled)"
            printf "  %-22s %s\n" "Web search length:" "${AGENT_WEB_SEARCH_MAX_LENGTH:-160}  (default: 160)"
            printf "  %-22s %s\n" "Web search operators:" "${AGENT_WEB_SEARCH_MAX_OPERATORS:-3}  (default: 3)"
            local _sr_show="disabled"
            [ "${AGENT_SMART_ROUTE:-1}" -eq 1 ] && _sr_show="enabled"
            printf "  %-22s %s\n" "Smart route:" "$_sr_show  (default: enabled)"
            local _ask_show="disabled"
            [ "${AGENT_ASK_USER:-1}" -eq 1 ] && _ask_show="enabled"
            printf "  %-22s %s\n" "Ask user (/ask):" "$_ask_show  (default: enabled)"
            local _bs_show="disabled"
            [ "${AGENT_BRAINSTORM:-1}" -eq 1 ] && _bs_show="enabled"
            printf "  %-22s %s\n" "Brainstorm:" "$_bs_show  (default: enabled)"
            local _fe_show="disabled"
            [ "${AGENT_FILE_EXPAND:-1}" -eq 1 ] && _fe_show="enabled"
            printf "  %-22s %s\n" "File expand:" "$_fe_show  (default: enabled)"
            printf "  %-22s %s\n" "DM scan chars:" "${AGENT_DM_SCAN_CHARS:-80}  (default: 80)"
            echo ""
            ui_section "Output Tokens (num_predict)"
            printf "  %-22s %s\n" "Max tokens:" "$LLM_MAX_TOKENS  (default: 20480)"
            printf "  %-22s %s\n" "Agent tokens:" "$LLM_AGENT_TOKENS  (default: 20480)"
            printf "  %-22s %s\n" "Strategist tokens:" "$LLM_STRATEGIST_TOKENS  (default: 512)"
            printf "  %-22s %s\n" "Evaluator tokens:" "$LLM_EVALUATOR_TOKENS  (default: 512)"
            printf "  %-22s %s\n" "Ask tokens:" "$LLM_ASK_TOKENS  (default: 20480)"
            printf "  %-22s %s\n" "Router tokens:" "$LLM_ROUTER_TOKENS  (default: 256)"
            echo ""
            ui_section "Think Budgets (budget_tokens, 0=unlimited)"
            printf "  %-22s %s\n" "Global default:" "$LLM_BUDGET_TOKENS  (default: 1024)"
            printf "  %-22s %s\n" "Ask (/ask):" "$LLM_BUDGET_ASK  (default: 1024)"
            printf "  %-22s %s\n" "Agent (strat/spec):" "$LLM_BUDGET_AGENT  (default: 512)"
            printf "  %-22s %s\n" "Router:" "$LLM_BUDGET_ROUTER  (default: 128)"
            printf "  %-22s %s\n" "Journal:" "$LLM_BUDGET_JOURNAL  (default: 64)"
            printf "  %-22s %s\n" "Tools:" "$LLM_BUDGET_TOOL  (default: 256)"
            echo ""
            ui_section "Provider Rate Limits"
            printf "  %-22s %s\n" "API call delay:" "${PROVIDER_CALL_DELAY}s  (default: 7)"
            printf "  %-22s %s\n" "Max retries:" "$PROVIDER_MAX_RETRIES  (default: 4)"
            printf "  %-22s %s\n" "Initial backoff:" "${PROVIDER_INITIAL_BACKOFF}s  (default: 5)"
            printf "  %-22s %s\n" "Max backoff:" "${PROVIDER_MAX_BACKOFF}s  (default: 60)"
            printf "  %-22s %s\n" "Cooldown max calls:" "$PROVIDER_COOLDOWN_MAX  (default: 8)"
            printf "  %-22s %s\n" "Cooldown window:" "${PROVIDER_COOLDOWN_WINDOW}s  (default: 60)"
            echo ""
            ui_dim "  Usage: /limits <param> [value]"
            ui_dim "  Reset: /limits reset"
            ui_dim "  Models: /limits models [provider]  — Free-tier rate limits per model"
            ui_dim "  Suggest: /limits suggest <provider> — Recommended settings"
            ui_dim "  Apply: /limits apply <provider>     — Apply suggested settings"
            ui_dim "  Fetch: /limits fetch <provider>     — List models from API" ;;
        *)
            ui_info "Usage: /limits [param] [value]"
            echo ""
            ui_dim "  Agent loop:"
            ui_dim "    steps N         — Max steps per plan/subtask (current: $AGENT_PLAN_STEPS)"
            ui_dim "    expand on|off   — Honeydew subtask expansion (current: $([ "${AGENT_HONEYDEW_EXPAND:-0}" -eq 1 ] && echo on || echo off))"
            ui_dim "    rewrite on|off  — Dynamic honeydew rewrite after milestones (current: $([ "${AGENT_HONEYDEW_REWRITE:-0}" -eq 1 ] && echo on || echo off))"
            ui_dim "    rewrite-rounds N — Max honeydew rewrite rounds per task (current: ${AGENT_HONEYDEW_REWRITE_ROUNDS:-3})"
            ui_dim "    rewrite-cadence N — Min milestones between rewrites, 0=every iter (current: ${AGENT_HONEYDEW_REWRITE_CADENCE:-2})"
            ui_dim "    force-rewrite on|off — Force rewrite on interlock/failure, bypass LLM router (current: $([ "${AGENT_FORCE_REWRITE:-1}" -eq 1 ] && echo on || echo off))"
            ui_dim "    depth N         — Subtask recursion depth (current: $AGENT_MAX_DEPTH)"
            ui_dim "    max-items N     — Max honeydew items before expansion suppressed (current: $AGENT_HONEYDEW_MAX_ITEMS)"
            ui_dim "    milestones N    — Macro loop milestone ceiling (current: $AGENT_MAX_STEPS)"
            ui_dim "    inner N         — Inner loop escalation retries (current: $AGENT_INNER_LOOPS)"
            ui_dim "    delay N         — Seconds between milestones (current: $AGENT_STEP_DELAY)"
            ui_dim "    eval-mode M     — Evaluator mode: auto|interactive|disabled (current: $AGENT_EVAL_MODE)"
            ui_dim "    eval-context N  — Max action log lines for evaluator (current: ${AGENT_EVAL_CONTEXT_LINES:-50})"
            ui_dim "    web-sufficiency N — Web actions before sufficiency signal (current: $AGENT_WEB_SUFFICIENCY)"
            ui_dim "    milestone-retries N — Max retries of same milestone (current: $AGENT_MAX_MILESTONE_RETRIES)"
            ui_dim "    cmd-family N     — Max milestones with same base command (current: $AGENT_MAX_CMD_FAMILY)"
            ui_dim "    honeydew-match N — Min keyword score for honeydew auto-check (current: $AGENT_HONEYDEW_MATCH)"
            ui_dim "    web-search-repeat N — Max consecutive /web search before forced fetch (current: ${AGENT_WEB_SEARCH_CONSEC_MAX:-20})"
            ui_dim "    tight-parsing on|off — Web search query cleaning mode: off=loose, on=strict (current: $([ "${AGENT_WEB_SEARCH_TIGHT_PARSING:-0}" -eq 1 ] && echo on || echo off))"
            ui_dim "    web-search-length N — Max character length for web search queries (current: ${AGENT_WEB_SEARCH_MAX_LENGTH:-160})"
            ui_dim "    web-search-ops N  — Max AND/OR operators in loose web search mode (current: ${AGENT_WEB_SEARCH_MAX_OPERATORS:-3})"
            ui_dim "    rec-chars N      — Max chars in evaluator recommendation to strategist (current: ${AGENT_EVAL_REC_CHARS:-120})"
            ui_dim "    smart-route on|off — Smart command routing heuristic (current: $([ "${AGENT_SMART_ROUTE:-1}" -eq 1 ] && echo on || echo off))"
            ui_dim "    ask on|off       — Allow George to /ask human questions (current: $([ "${AGENT_ASK_USER:-1}" -eq 1 ] && echo on || echo off))"
            ui_dim "    brainstorm on|off — Allow George to /brainstorm (self-reason) (current: $([ "${AGENT_BRAINSTORM:-1}" -eq 1 ] && echo on || echo off))"
            ui_dim "    file-expand on|off — Auto-expand file refs in /social /email /write (current: $([ "${AGENT_FILE_EXPAND:-1}" -eq 1 ] && echo on || echo off))"
            ui_dim "    dm-scan-chars N  — Chars to scan for DM recipients in /social discord dm (current: ${AGENT_DM_SCAN_CHARS:-80})"
            echo ""
            ui_dim "  Output tokens (num_predict):"
            ui_dim "    max-tokens N    — Global max output cap (current: $LLM_MAX_TOKENS)"
            ui_dim "    tokens N        — Agent specialist (current: $LLM_AGENT_TOKENS)"
            ui_dim "    strat-tokens N  — Strategist milestone (current: $LLM_STRATEGIST_TOKENS)"
            ui_dim "    eval-tokens N   — Evaluator completion judge (current: $LLM_EVALUATOR_TOKENS)"
            ui_dim "    ask-tokens N    — /ask conversation (current: $LLM_ASK_TOKENS)"
            ui_dim "    router-tokens N — Router tool selection (current: $LLM_ROUTER_TOKENS)"
            echo ""
            ui_dim "  Think budgets (budget_tokens, 0=unlimited):"
            ui_dim "    budget N        — Global default fallback (current: $LLM_BUDGET_TOKENS)"
            ui_dim "    budget-ask N    — /ask conversations (current: $LLM_BUDGET_ASK)"
            ui_dim "    budget-agent N  — Strategist/specialist (current: $LLM_BUDGET_AGENT)"
            ui_dim "    budget-router N — Router tool selection (current: $LLM_BUDGET_ROUTER)"
            ui_dim "    budget-journal N — Journal reflect/quip (current: $LLM_BUDGET_JOURNAL)"
            ui_dim "    budget-tool N   — Commit, web, recall, slash (current: $LLM_BUDGET_TOOL)"
            echo ""
            ui_dim "  Provider rate limits:"
            ui_dim "    api-delay N          — Seconds between API calls (current: $PROVIDER_CALL_DELAY)"
            ui_dim "    api-retries N        — Max retry attempts on 429 (current: $PROVIDER_MAX_RETRIES)"
            ui_dim "    api-backoff N        — Initial backoff seconds (current: $PROVIDER_INITIAL_BACKOFF)"
            ui_dim "    api-max-backoff N    — Max backoff cap seconds (current: $PROVIDER_MAX_BACKOFF)"
            ui_dim "    api-cooldown-max N   — Max calls in cooldown window (current: $PROVIDER_COOLDOWN_MAX)"
            ui_dim "    api-cooldown-window N — Cooldown window seconds (current: $PROVIDER_COOLDOWN_WINDOW)"
            echo ""
            ui_dim "  Free-tier tools:"
            ui_dim "    models [provider]    — Show models with free-tier rate limits"
            ui_dim "    suggest <provider>   — Show recommended /limit settings"
            ui_dim "    apply <provider>     — Apply suggested settings automatically"
            ui_dim "    fetch <provider>     — List models from provider API"
            echo ""
            ui_dim "    reset           — Reset all to defaults" ;;
    esac
}
_cmd_models() {
    local args="$1"
    local action
    action=$(echo "$args" | awk '{print $1}')
    local arg2
    arg2=$(echo "$args" | awk '{print $2}')
    local arg3
    arg3=$(echo "$args" | awk '{print $3}')

    case "$action" in
        list|ls)
            models_list ;;
        status|info)
            models_status ;;
        select|set)
            models_select "$arg2" "$arg3" ;;
        single)
            models_select single "$arg2" ;;
        dual)
            if [ "${LODGE_SINGLE_MODEL:-0}" -eq 1 ]; then
                LODGE_SINGLE_MODEL=0
                _MODELS_ACTIVE=""
                LODGE_MODEL="$LODGE_MODEL_PRIMARY"
                ui_ok "Dual-model mode enabled"
                ui_dim "  Primary:   $LODGE_MODEL_PRIMARY (ask, agent)"
                ui_dim "  Secondary: $LODGE_MODEL_SECONDARY (router, tool, journal)"
            else
                ui_info "Already in dual-model mode"
            fi ;;
        param|params)
            # /models param                    — show params for active models
            # /models param <key>              — show params for a model
            # /models param <key> <p> <val>    — set a param
            # /models param <key> clear        — clear all overrides for model
            # /models param <key> clear <p>    — clear one override
            if [ -z "$arg2" ]; then
                models_show_params
            elif [ -z "$arg3" ]; then
                models_show_params "$arg2"
            else
                local arg4
                arg4=$(echo "$args" | awk '{print $4}')
                if [ "$arg3" = "clear" ]; then
                    if [ -n "$arg4" ]; then
                        models_clear_param "$arg2" "$arg4"
                        ui_ok "Cleared $arg4 override for $arg2"
                    else
                        models_clear_all_params "$arg2"
                        ui_ok "Cleared all overrides for $arg2"
                    fi
                else
                    if [ -z "$arg4" ]; then
                        ui_err "Usage: /models param <model> <param> <value>"
                    else
                        if models_set_param "$arg2" "$arg3" "$arg4"; then
                            ui_ok "Set $arg2 $arg3 = $arg4"
                            ui_dim "  (Override active until session ends or cleared with /models param $arg2 clear $arg3)"
                        fi
                    fi
                fi
            fi ;;
        "")
            models_status
            echo ""
            models_list ;;
        *)
            ui_info "Usage: /models [list|status|select|single|dual|param]"
            ui_dim "  list               — show available models"
            ui_dim "  status             — show current configuration"
            ui_dim "  select primary <key>  — set primary model"
            ui_dim "  select secondary <key> — set secondary model"
            ui_dim "  single <key>       — single-model mode (no switching)"
            ui_dim "  dual               — enable dual-model mode"
            ui_dim "  param [key]        — show model parameters"
