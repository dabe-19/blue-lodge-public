_cmd_model() {
    local args="$1"
    local action
    action=$(echo "$args" | awk '{print $1}')
    local value
    value=$(echo "$args" | awk '{print $2}')

    # Float validator: _model_set VAR_NAME "Label" value min max
    _model_set() {
        local var_name="$1" label="$2" val="$3" min="$4" max="$5"
        if ! [[ "$val" =~ ^[0-9]+\.?[0-9]*$ ]]; then
            ui_err "$label must be a number (e.g. 1.3)"
            return 1
        fi
        # Compare floats via awk
        if ! awk "BEGIN { exit ($val >= $min && $val <= $max) ? 0 : 1 }"; then
            ui_err "$label must be between $min and $max"
            return 1
        fi
        eval "$var_name=$val"
        _llm_save_config
        ui_ok "$label set to $val"
    }

    case "$action" in
        # ── Global defaults ──────────────────────────────
        temp|temperature)
            if [ -z "$value" ]; then
                ui_info "Global temperature: $LLM_TEMPERATURE (model default)"
