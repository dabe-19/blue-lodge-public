    local args="$1"
    local action
    action=$(echo "$args" | awk '{print $1}')
    local rest
    rest=$(echo "$args" | sed 's/^[^ ]* *//')
    
    case "$action" in
        keys)
            local sub
            sub=$(echo "$rest" | awk '{print $1}')
            local keyargs
            keyargs=$(echo "$rest" | sed 's/^[^ ]* *//')
            case "$sub" in
                list|ls|"") api_list_keys ;;
                set)
                    local kname kval
                    kname=$(echo "$keyargs" | awk '{print $1}')
                    kval=$(echo "$keyargs" | awk '{print $2}')
                    if [ -z "$kname" ] || [ -z "$kval" ]; then
                        ui_err "Usage: /api keys set KEY_NAME value"
                        return 1
                    fi
                    api_init
                    api_set_key "$kname" "$kval"
                    ui_ok "Key $kname saved" ;;
                rm|remove)
                    local kname
                    kname=$(echo "$keyargs" | awk '{print $1}')
