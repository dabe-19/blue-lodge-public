                        if api_get_key "DISCORD_WEBHOOK_URL" &>/dev/null; then
                            discord_webhook "$dargs"
                        elif api_get_key "DISCORD_BOT_TOKEN" &>/dev/null; then
                            local _def_chan
                            _def_chan=$(discord_default_channel)
                            if [ -n "$_def_chan" ]; then
                                discord_send "$_def_chan" "$dargs"
                            else
                                ui_err "Could not resolve '$_first_arg' as a channel, and no default set"
                                ui_dim "Sync: /social discord channels sync"
                            fi
                        else
                            ui_err "Discord not configured"
                        fi
                    fi ;;
                dm)
                    # /social discord dm <user[s]> <text>
                    # Multi-DM: scans first AGENT_DM_SCAN_CHARS characters for
                    # multiple recipient names, resolves each, sends a DM to all.
                    if [ -z "$dargs" ]; then
                        ui_info "Usage: /social discord dm <user(s)> <message>"
                        ui_dim "  Multiple: /social discord dm Babadoo and Nubster Hey!"
                        ui_dim "  Sync users first: /social discord users sync"
                        return 1
                    fi

                    if declare -f discord_dm_parse_recipients &>/dev/null; then
                        discord_dm_parse_recipients "$dargs"
                    else
                        _DM_RESOLVED_IDS=()
                        _DM_MESSAGE=""
                    fi

                    if [ ${#_DM_RESOLVED_IDS[@]} -gt 0 ] && [ -n "$_DM_MESSAGE" ]; then
                        # Send DM to each resolved recipient
                        local _dm_ok=0 _dm_fail=0 _dm_uid
                        for _dm_uid in "${_DM_RESOLVED_IDS[@]}"; do
                            if discord_dm "$_dm_uid" "$_DM_MESSAGE"; then
                                _dm_ok=$((_dm_ok + 1))
                            else
                                _dm_fail=$((_dm_fail + 1))
                            fi
                        done
                        if [ ${#_DM_RESOLVED_IDS[@]} -gt 1 ]; then
                            [ "$_dm_fail" -eq 0 ] \
                                && ui_ok "Multi-DM complete: ${_dm_ok} sent to ${#_DM_RESOLVED_IDS[@]} recipients" \
                                || ui_warn "Multi-DM: ${_dm_ok} sent, ${_dm_fail} failed (${#_DM_RESOLVED_IDS[@]} recipients)"
                        fi
                    else
                        # Fallback: single-user DM (original behavior)
                        local _dm_user _dm_text
                        _dm_user=$(echo "$dargs" | awk '{print $1}')
                        _dm_text=$(echo "$dargs" | sed 's/^[^ ]* *//')
                        if [ -z "$_dm_user" ] || [ -z "$_dm_text" ] || [ "$_dm_text" = "$_dm_user" ]; then
                            ui_info "Usage: /social discord dm <user_id_or_name> <message>"
                            ui_dim "  Sync users first: /social discord users sync"
                            return 1
                        fi
                        # Resolve username → user ID if not numeric
                        if ! [[ "$_dm_user" =~ ^[0-9]+$ ]]; then
                            local _uid
                            _uid=$(discord_user_resolve "$_dm_user")
                            if [ -z "$_uid" ]; then
                                ui_err "Unknown user: $_dm_user"
                                ui_dim "Sync users: /social discord users sync"
                                return 1
                            fi
                            _dm_user="$_uid"
                        fi
                        discord_dm "$_dm_user" "$_dm_text"
                    fi ;;
                read)
                    local cid
                    cid=$(echo "$dargs" | awk '{print $1}')
                    discord_read "$cid" ;;
                validate|test)
                    discord_validate ;;
                channels|ch)
                    local ch_sub
                    ch_sub=$(echo "$dargs" | awk '{print $1}')
                    local ch_args
                    ch_args=$(echo "$dargs" | sed 's/^[^ ]* *//')
                    case "$ch_sub" in
                        list|ls|"")
                            discord_channel_list ;;
                        add)
                            local ch_name ch_id
                            ch_name=$(echo "$ch_args" | awk '{print $1}')
                            ch_id=$(echo "$ch_args" | awk '{print $2}')
                            if [ -z "$ch_name" ] || [ -z "$ch_id" ]; then
                                ui_info "Usage: /social discord channels add <name> <channel_id>"
                            else
                                discord_channel_add "$ch_name" "$ch_id"
                            fi ;;
                        remove|rm)
                            local ch_name
                            ch_name=$(echo "$ch_args" | awk '{print $1}')
                            if [ -z "$ch_name" ]; then
                                ui_info "Usage: /social discord channels remove <name>"
                            else
                                discord_channel_remove "$ch_name"
                            fi ;;
                        sync)
                            discord_channels_sync ;;
                        *)
                            ui_info "Usage: /social discord channels <list|add|remove|sync>" ;;
                    esac ;;
                users)
                    local u_sub
                    u_sub=$(echo "$dargs" | awk '{print $1}')
                    local u_args
                    u_args=$(echo "$dargs" | sed 's/^[^ ]* *//')
                    case "$u_sub" in
                        list|ls|"")
                            discord_user_list ;;
                        add)
                            local u_name u_id
                            u_name=$(echo "$u_args" | awk '{print $1}')
                            u_id=$(echo "$u_args" | awk '{print $2}')
                            if [ -z "$u_name" ] || [ -z "$u_id" ]; then
                                ui_info "Usage: /social discord users add <username> <user_id>"
                            else
                                discord_user_add "$u_name" "$u_id"
                            fi ;;
                        remove|rm)
                            local u_name
                            u_name=$(echo "$u_args" | awk '{print $1}')
                            if [ -z "$u_name" ]; then
                                ui_info "Usage: /social discord users remove <username>"
                            else
                                discord_user_remove "$u_name"
                            fi ;;
                        sync)
                            discord_users_sync ;;
                        resolve)
                            local u_name
                            u_name=$(echo "$u_args" | awk '{print $1}')
                            if [ -z "$u_name" ]; then
                                ui_info "Usage: /social discord users resolve <username>"
                            else
                                local _uid
                                _uid=$(discord_user_resolve "$u_name")
                                if [ -n "$_uid" ]; then
                                    ui_success "$u_name → $_uid"
                                else
                                    ui_err "User not found: $u_name"
                                fi
                            fi ;;
                        *)
                            ui_info "Usage: /social discord users <list|add|remove|sync|resolve>" ;;
                    esac ;;
                *)
                    ui_info "Usage: /social discord <post|dm|read|validate|channels|users>"
                    ui_dim "  post [channel] <text>      — Post to channel (resolves names)"
                    ui_dim "  dm <user> <text>            — Send DM to user"
                    ui_dim "  read <channel>              — Read recent messages"
                    ui_dim "  validate                    — Test bot token"
                    ui_dim "  channels <list|add|rm|sync> — Manage channel registry"
                    ui_dim "  users <list|add|rm|sync>    — Manage user registry"
                    ;;
            esac ;;
        telegram|tg)
            local sub
            sub=$(echo "$rest" | awk '{print $1}')
            local targs
            targs=$(echo "$rest" | sed 's/^[^ ]* *//')
            case "$sub" in
                post|send) telegram_send "$targs" ;;
                updates)   telegram_get_updates ;;
                me)        telegram_get_me ;;
                *)         ui_info "Usage: /social telegram <post|updates|me>" ;;
            esac ;;
        status) social_status ;;
        *)
            ui_info "Usage: /social <post|x|mastodon|bluesky|discord|telegram|status>"
            ui_dim "  post <platform> [channel] <text> — Post to a platform"
            ui_dim "  x <action>                       — X/Twitter commands"
            ui_dim "  mastodon <action>                 — Mastodon commands (incl. instances)"
            ui_dim "  bluesky <action>                  — Bluesky commands"
            ui_dim "  discord <action>                  — Discord commands (incl. users, dm)"
            ui_dim "  telegram <action>                 — Telegram commands"
            ui_dim "  status                            — Show configured platforms"
            ;;
    esac
}
_cmd_provider() {
    local args="$1"
    local action
    action=$(echo "$args" | awk '{print $1}')
    local rest
    rest=$(echo "$args" | sed 's/^[^ ]* *//')

    case "$action" in
        chat|ask)
            local provider
            provider=$(echo "$rest" | awk '{print $1}')
            local message
            message=$(echo "$rest" | sed 's/^[^ ]* *//')
            # Support provider/model syntax: google/gemma-3-27b-it
            local model_override=""
            if [[ "$provider" == */* ]]; then
                model_override="${provider#*/}"
                provider="${provider%%/*}"
            fi
            if [ -z "$provider" ] || [ -z "$message" ]; then
                ui_err "Usage: /provider chat <provider>[/model] <message>"
                return 1
            fi
            local response
            response=$(provider_chat "$provider" "$message" "$model_override")
            if [ $? -eq 0 ] && [ -n "$response" ]; then
                echo ""
                ui_render_response "$response"
            fi ;;
        models)
            local provider
            provider=$(echo "$rest" | awk '{print $1}')
            case "$provider" in
                openai)    openai_models ;;
                google)    google_models ;;
                anthropic) anthropic_models ;;
                *)         ui_err "Usage: /provider models <openai|google|anthropic>" ;;
            esac ;;
        model)
            local provider model_name
            provider=$(echo "$rest" | awk '{print $1}')
            model_name=$(echo "$rest" | awk '{print $2}')
            if [ -z "$provider" ]; then
                ui_err "Usage: /provider model <provider> [model|clear]"
                ui_dim "  Show or set the default model for a provider"
                ui_dim "  /provider model google              — show current default"
                ui_dim "  /provider model google gemma-3-27b-it — set default"
                ui_dim "  /provider model google clear         — reset to built-in"
                return 1
            fi
            if [ -z "$model_name" ]; then
                local current
                current=$(provider_get_model "$provider")
                if [ -n "$current" ]; then
                    ui_info "Default model for $provider: $current"
                else
                    ui_info "No custom model set for $provider (using built-in default)"
                fi
            elif [ "$model_name" = "clear" ] || [ "$model_name" = "reset" ]; then
                provider_clear_model "$provider"
            else
                provider_set_model "$provider" "$model_name"
            fi ;;
        status) provider_status ;;
        use|harness)
            local provider
            provider=$(echo "$rest" | awk '{print $1}')
            # Support provider/model syntax: google/gemini-2.5-pro
            local model_override=""
            if [[ "${provider:-}" == */* ]]; then
                model_override="${provider#*/}"
                provider="${provider%%/*}"
            fi
            if [ -n "$model_override" ]; then
                provider_set_model "$provider" "$model_override"
            fi
            provider_use "${provider:-}" ;;
        delay|throttle)
            local secs
            secs=$(echo "$rest" | awk '{print $1}')
            if [ -z "$secs" ]; then
                local cur
                cur=$(provider_get_delay)
                if [ "$cur" -gt 0 ] 2>/dev/null; then
                    ui_info "Current call delay: ${cur}s between LLM calls"
                else
                    ui_info "No call delay set (calls fire immediately)"
                fi
                ui_dim "  Set: /provider delay 30"
                ui_dim "  Off: /provider delay 0"
            else
                provider_set_delay "$secs"
            fi ;;
        *)
            ui_info "Usage: /provider <chat|use|delay|model|models|status>"
            ui_dim "  use <provider>[/model]  — Route ALL LLM calls through provider"
            ui_dim "  use local               — Switch back to local backend"
            ui_dim "  delay <seconds>         — Set minimum gap between LLM calls"
            ui_dim "  chat <provider>[/model] <msg> — Send a message to a cloud AI"
            ui_dim "  model <provider> [model|clear] — Get/set default model"
            ui_dim "  models <provider>     — List available models from API"
            ui_dim "  status                — Show configured providers"
            ui_dim ""
            ui_dim "  Providers: openai, anthropic, google, groq, mistral,"
            ui_dim "             together, perplexity, cohere, deepseek, xai"
            ;;
    esac
}
