_cmd_api() {
    local args="$1"
    local action
    action=$(echo "$args" | awk '{print $1}')
    local rest
    rest=$(echo "$args" | sed 's/^[^ ]* *//')
    
    case "$action" in
        keys)
            local sub
            sub=$(echo "$rest" | awk '{print $1}')
            local keyargs
            keyargs=$(echo "$rest" | sed 's/^[^ ]* *//')
            case "$sub" in
                list|ls|"") api_list_keys ;;
                set)
                    local kname kval
                    kname=$(echo "$keyargs" | awk '{print $1}')
                    kval=$(echo "$keyargs" | awk '{print $2}')
                    if [ -z "$kname" ] || [ -z "$kval" ]; then
                        ui_err "Usage: /api keys set KEY_NAME value"
                        return 1
                    fi
                    api_init
                    api_set_key "$kname" "$kval"
                    ui_ok "Key $kname saved" ;;
                rm|remove)
                    local kname
                    kname=$(echo "$keyargs" | awk '{print $1}')
                    if [ -n "$kname" ] && [ -f "$GEORGE_KEYS_FILE" ]; then
                        local tmpfile; tmpfile=$(mktemp)
                        grep -v "^${kname}=" "$GEORGE_KEYS_FILE" > "$tmpfile"
                        mv "$tmpfile" "$GEORGE_KEYS_FILE"
                        ui_ok "Key $kname removed"
                    fi ;;
                *) ui_info "Usage: /api keys <list|set|rm>" ;;
            esac ;;
        status)
            api_init
            social_status
            echo ""
            provider_status ;;
        *)
            ui_info "Usage: /api <keys|status>"
            ui_dim "  keys list     — Show configured API keys"
            ui_dim "  keys set K V  — Set an API key"
            ui_dim "  keys rm K     — Remove an API key"
            ui_dim "  status        — Show integration status"
            ;;
    esac
}
_cmd_social() {
    local args="$1"
    local action
    action=$(echo "$args" | awk '{print $1}')
    local rest
    rest=$(echo "$args" | sed 's/^[^ ]* *//')

    case "$action" in
        post)
            local platform text
            platform=$(echo "$rest" | awk '{print $1}')
            text=$(echo "$rest" | sed 's/^[^ ]* *//')
            if [ -z "$text" ]; then
                # No platform specified — text is everything
                text="$platform"
                social_post "$text"
            else
                social_post "$text" "$platform"
            fi ;;
        x|twitter)
            local sub
            sub=$(echo "$rest" | awk '{print $1}')
            local xargs
            xargs=$(echo "$rest" | sed 's/^[^ ]* *//')
            case "$sub" in
                post)    x_post "$xargs" ;;
                search)  x_search "$xargs" ;;
                timeline) x_timeline ;;
                reply)
                    local tid txt
                    tid=$(echo "$xargs" | awk '{print $1}')
                    txt=$(echo "$xargs" | sed 's/^[^ ]* *//')
                    x_reply "$tid" "$txt" ;;
                delete)  x_delete "$xargs" ;;
                *)       ui_info "Usage: /social x <post|search|timeline|reply|delete>" ;;
            esac ;;
        mastodon|masto)
            local sub
            sub=$(echo "$rest" | awk '{print $1}')
            local margs
            margs=$(echo "$rest" | sed 's/^[^ ]* *//')
            case "$sub" in
                post)       mastodon_post "$margs" ;;
                timeline)   mastodon_timeline ;;
                search)     mastodon_search "$margs" ;;
                notify)     mastodon_notifications ;;
                *)          ui_info "Usage: /social mastodon <post|timeline|search|notify>" ;;
            esac ;;
        bluesky|bsky)
            local sub
            sub=$(echo "$rest" | awk '{print $1}')
            local bargs
            bargs=$(echo "$rest" | sed 's/^[^ ]* *//')
            case "$sub" in
                post)     bluesky_post "$bargs" ;;
                timeline) bluesky_timeline ;;
                search)   bluesky_search "$bargs" ;;
                *)        ui_info "Usage: /social bluesky <post|timeline|search>" ;;
            esac ;;
        discord)
            local sub
            sub=$(echo "$rest" | awk '{print $1}')
            local dargs
            dargs=$(echo "$rest" | sed 's/^[^ ]* *//')
            case "$sub" in
                send|post) discord_webhook "$dargs" ;;
                read)
                    local cid
                    cid=$(echo "$dargs" | awk '{print $1}')
                    discord_read "$cid" ;;
                *)        ui_info "Usage: /social discord <send|read>" ;;
            esac ;;
        telegram|tg)
            local sub
            sub=$(echo "$rest" | awk '{print $1}')
            local targs
            targs=$(echo "$rest" | sed 's/^[^ ]* *//')
            case "$sub" in
                send|post) telegram_send "$targs" ;;
                updates)   telegram_get_updates ;;
                me)        telegram_get_me ;;
                *)         ui_info "Usage: /social telegram <send|updates|me>" ;;
            esac ;;
        status) social_status ;;
        *)
            ui_info "Usage: /social <post|x|mastodon|bluesky|discord|telegram|status>"
            ui_dim "  post <text>          — Post to all configured platforms"
            ui_dim "  post <platform> text — Post to a specific platform"
            ui_dim "  x <action>           — X/Twitter commands"
            ui_dim "  mastodon <action>    — Mastodon commands"
            ui_dim "  bluesky <action>     — Bluesky commands"
            ui_dim "  discord <action>     — Discord commands"
            ui_dim "  telegram <action>    — Telegram commands"
            ui_dim "  status               — Show configured platforms"
            ;;
    esac
}
_cmd_provider() {
    local args="$1"
    local action
    action=$(echo "$args" | awk '{print $1}')
    local rest
    rest=$(echo "$args" | sed 's/^[^ ]* *//')

    case "$action" in
        chat|ask)
            local provider
            provider=$(echo "$rest" | awk '{print $1}')
            local message
            message=$(echo "$rest" | sed 's/^[^ ]* *//')
            if [ -z "$provider" ] || [ -z "$message" ]; then
                ui_err "Usage: /provider chat <provider> <message>"
                return 1
            fi
            local response
            response=$(provider_chat "$provider" "$message")
            if [ $? -eq 0 ]; then
                echo ""
                ui_render_response "$response"
            fi ;;
        models)
            local provider
            provider=$(echo "$rest" | awk '{print $1}')
            case "$provider" in
                openai)    openai_models ;;
                google)    google_models ;;
                anthropic) anthropic_models ;;
                *)         ui_err "Usage: /provider models <openai|google|anthropic>" ;;
            esac ;;
        status) provider_status ;;
        *)
            ui_info "Usage: /provider <chat|models|status>"
            ui_dim "  chat <provider> <msg> — Send a message to a cloud AI"
            ui_dim "  models <provider>     — List available models"
            ui_dim "  status                — Show configured providers"
            ui_dim ""
            ui_dim "  Providers: openai, anthropic, google, groq, mistral,"
            ui_dim "             together, perplexity, cohere, deepseek, xai"
            ;;
    esac
}
