_cmd_email() {
    local args="$1"
    local action
    action=$(echo "$args" | awk '{print $1}')
    local rest
    rest=$(echo "$args" | sed 's/^[^ ]* *//')

    # ── Normalize provider token ──────────────────────────────
    # LLMs sometimes output provider=gmail, p=gmail, or just gmail.
    # Strip known prefixes so all variants resolve to the bare name.
    _normalize_provider() {
        local _val="$1"
        _val="${_val#provider=}"  # strip provider= prefix
        _val="${_val#p=}"         # strip p= prefix
        echo "$_val"
    }

    case "$action" in
        setup|configure)
            rest=$(_normalize_provider "$rest")
            email_setup "$rest" ;;
        status|info)
            local _st_provider
            _st_provider=$(echo "$rest" | awk '{print $1}')
            [ "$_st_provider" = "$action" ] && _st_provider=""
            _st_provider=$(_normalize_provider "$_st_provider")
            email_status "$_st_provider"
            ssh_status ;;
        send)
            # ── Smart email send parser ────────────────────────────
            # Accepted formats (all equivalent):
            #   /email send <provider> <recipient> s=subject words b=body words
            #   /email send <provider> to=addr s=subject b=body
            #   /email send <provider> address=addr s=subject b=body
            #   /email send <provider> <recipient> subject=subject words body=body words
            #   /email send <provider> to=addr subject=Hello body=World
            # - Recipient can be positional (right after provider) OR via to= / address=
            # - s= / subject= are aliases; b= / body= are aliases
            # - s= and b= are preferred for multi-line/multi-word input
            local provider _send_rest to subject body
            provider=$(_normalize_provider "$(echo "$rest" | awk '{print $1}')")
            _send_rest=$(echo "$rest" | sed 's/^[^ ]* *//')
            if [ -z "$provider" ] || [ -z "$_send_rest" ] || [ "$_send_rest" = "$provider" ]; then
                ui_info "Usage: /email send <provider> <recipient> s=subject b=body [f=file.txt]"
                ui_dim "  provider: gmail, protonmail, zoho"
                ui_dim "  Recipient goes right after provider, or use to=addr / address=addr"
                ui_dim "  Example: /email send gmail user@example.com s=Hello there b=How are you today?"
                ui_dim "  Attach:  /email send gmail user@example.com s=Report b=See attached f=notes.md"
                ui_dim "  Also accepts: subject= and body= as aliases for s= and b="
                ui_dim "  Also accepts: file= and attach= as aliases for f="
                ui_dim "  s= and b= capture everything until the next key or end of input."
                return 1
            fi

            # ── Normalize aliases: address= → to=, subject= → s=, body= → b= ─
            # Do this BEFORE any parsing so the rest of the logic
            # only needs to handle to=, s=, b=, and f=.
            # Use longest-match to avoid partial replacements.
            _send_rest="${_send_rest//address=/to=}"
            _send_rest="${_send_rest//subject=/s=}"
            _send_rest="${_send_rest//body=/b=}"
            _send_rest="${_send_rest//file=/f=}"
            _send_rest="${_send_rest//attach=/f=}"

            # ── Parse f= (attachment file path, single token) ─────
            local attachment=""
            if [[ "$_send_rest" =~ f=([^[:space:]]+) ]]; then
                attachment="${BASH_REMATCH[1]}"
                _send_rest="${_send_rest/f=${attachment}/}"
                _send_rest="${_send_rest## }"
            fi

            # ── Parse to= (email address, single token) ───────────
            to=""
            if [[ "$_send_rest" =~ to=([^[:space:]]+) ]]; then
                to="${BASH_REMATCH[1]}"
                # Strip to=addr from _send_rest so it doesn't interfere
                _send_rest="${_send_rest/to=${to}/}"
                _send_rest="${_send_rest## }"  # trim leading space
            fi

            # ── Positional recipient: first token if it looks like an email ──
            if [ -z "$to" ]; then
                local _first_token
                _first_token=$(echo "$_send_rest" | awk '{print $1}')
                if [[ "$_first_token" == *@*.* ]] && [[ "$_first_token" != s=* ]] && [[ "$_first_token" != b=* ]]; then
                    to="$_first_token"
                    _send_rest=$(echo "$_send_rest" | sed 's/^[^ ]* *//')
                fi
            fi

            # ── Parse s= (everything from s= to b= or f= or end) ────
            if [[ "$_send_rest" == *"s="* ]]; then
                local _after_s="${_send_rest#*s=}"
                if [[ "$_after_s" == *" b="* ]]; then
                    subject="${_after_s%% b=*}"
                elif [[ "$_after_s" == *" f="* ]]; then
                    subject="${_after_s%% f=*}"
                else
                    subject="$_after_s"
                fi
                # Trim trailing whitespace
                subject="${subject%"${subject##*[![:space:]]}"}"
            else
                subject=""
            fi

            # ── Parse b= (everything from b= to f= or end) ───────
            if [[ "$_send_rest" == *" b="* ]]; then
                body="${_send_rest#* b=}"
            elif [[ "$_send_rest" == "b="* ]]; then
                body="${_send_rest#b=}"
            else
                body=""
            fi
            # Stop body at f= if present
            if [ -n "$body" ] && [[ "$body" == *" f="* ]]; then
                body="${body%% f=*}"
            fi

            if [ -z "$to" ] || [ -z "$subject" ]; then
                ui_err "Missing required fields (recipient and subject are required)"
                ui_dim "  Usage: /email send <provider> <recipient> s=subject b=body [f=file.txt]"
                ui_dim "  Example: /email send gmail user@example.com s=Hello b=How are you?"
                ui_dim "  Attach:  /email send gmail user@example.com s=Report b=See attached f=report.md"
                return 1
            fi

            # ── Inline /read expansion in body ─────────────────
            # LLM may emit body=/read report.txt to inline a file.
            if [[ "$body" == */read\ * ]] || [[ "$body" == /read\ * ]]; then
                if declare -f tools_expand_inline_read &>/dev/null; then
                    body=$(tools_expand_inline_read "$body")
                fi
            fi

            # ── Auto-expand file references in body ────────────
            # File paths (e.g. report.md, notes.txt) in the body are
            # replaced with their contents when AGENT_FILE_EXPAND=1.
            if [ "${AGENT_FILE_EXPAND:-1}" -eq 1 ] && declare -f tools_expand_file_refs &>/dev/null; then
                body=$(tools_expand_file_refs "$body")
            fi

            email_send "$provider" "$to" "$subject" "$body" "$attachment" ;;
        inbox|check)
            # Syntax: /email inbox <provider> [count]
            local _inbox_provider _inbox_count
            _inbox_provider=$(_normalize_provider "$(echo "$rest" | awk '{print $1}')")
            _inbox_count=$(echo "$rest" | awk '{print $2}')
            if [ -z "$_inbox_provider" ] || [ "$_inbox_provider" = "$action" ]; then
                ui_info "Usage: /email inbox <provider> [count]"
                ui_dim "  provider: gmail, protonmail, zoho, disposable"
                ui_dim "  Example: /email inbox gmail 10"
                return 1
            fi
            email_inbox "$_inbox_provider" "${_inbox_count:-5}" ;;
        address)
            local _addr_provider
            _addr_provider=$(_normalize_provider "$(echo "$rest" | awk '{print $1}')")
            [ "$_addr_provider" = "$action" ] && _addr_provider=""
            local addr
            addr=$(email_get_address "$_addr_provider")
            if [ -n "$addr" ]; then
                echo "$addr"
            else
                ui_info "No email configured. Run: /email setup <provider>"
            fi ;;
        ssh-keygen|sshkeygen|keygen)
            ssh_generate_key ;;
        ssh-test|sshtest|ssh-status)
            ssh_status ;;
        github-setup|ghsetup|github)
            github_setup ;;
        github-test|ghtest)
            ssh_test_github ;;
        bridge)
            local sub
            sub=$(echo "$rest" | awk '{print $1}')
            local sub_rest
            sub_rest=$(echo "$rest" | sed 's/^[^ ]* *//')
            case "$sub" in
                setup)     bridge_setup ;;
                install)   bridge_install_deps ;;
                init-pass|initpass|init) bridge_init_pass ;;
                start)     bridge_start ;;
                stop)      bridge_stop ;;
                status)    bridge_status ;;
                login)     bridge_login ;;
                configure) bridge_configure ;;
                test)      bridge_test ;;
                *)
                    ui_info "Usage: /email bridge <setup|start|stop|status|login|configure|test>"
                    ui_dim "  setup     — Full guided setup (deps → login → configure → start)"
                    ui_dim "  install   — Install dependencies (gnupg, pass)"
                    ui_dim "  init-pass — Initialize pass store (GPG key + keychain)"
                    ui_dim "  start     — Start bridge daemon in background"
                    ui_dim "  stop      — Stop bridge daemon"
                    ui_dim "  status    — Show bridge health (process, ports, config)"
                    ui_dim "  login     — Interactive bridge CLI login (enter Proton credentials)"
                    ui_dim "  configure — Set George's email to use bridge SMTP/IMAP"
                    ui_dim "  test      — Test SMTP connection through bridge"
                    ;;
            esac ;;
        *)
